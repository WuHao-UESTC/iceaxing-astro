// Evenly spaced foothills: no compressed columns or needle-shaped eastern peaks.
// Each ridge has its own crest and reaches below the viewport, so foreground
// ridges actually occlude the ones behind them.
function studyRidgeRows(crest: number[], depth: number): TerrainPoint[][] {
  return [0, 0.52, 1].map((t, row) =>
    crest.map((height, column): TerrainPoint => [
      -80 + (column * 1600) / (crest.length - 1),
      height * (1 - t) + 360 * t,
      row === 2 ? 0 : depth + ((column * 31 + row * 17) % 65),
    ]),
  );
}

export const studyRows = studyRidgeRows(
  [235, 195, 145, 185, 125, 170, 140, 190, 130, 180, 220],
  30,
);

export const studyMountainLayers = [
  { depth: 'distant', rows: studyRows, shade: 0 },
  {
    depth: 'middle',
    rows: studyRidgeRows([275, 235, 220, 180, 225, 195, 225, 175, 215, 205, 255], 60),
    shade: 2,
  },
  {
    depth: 'near',
    rows: studyRidgeRows([310, 280, 260, 290, 250, 280, 255, 285, 245, 275, 305], 90),
    shade: 4,
  },
].map(({ depth, rows, shade }) => ({
  depth,
  // Keep each ridge in a distinct tonal band while retaining adjacent facets.
  faces: createTerrainMesh(rows).map((face) => ({ ...face, shade: shade + (face.shade % 2) })),
}));

// Fewer, shallower facets keep their proportions when the SVG is narrow.
export const compactStudyMountainLayers = [
  {
    depth: 'distant',
    rows: studyRidgeRows([235, 145, 195, 140, 190, 230], 30),
    shade: 0,
  },
  {
    depth: 'middle',
    rows: studyRidgeRows([275, 225, 185, 230, 190, 270], 60),
    shade: 2,
  },
  {
    depth: 'near',
    rows: studyRidgeRows([310, 260, 290, 255, 295, 290], 90),
    shade: 4,
  },
].map(({ depth, rows, shade }) => ({
  depth,
  faces: createTerrainMesh(rows).map((face) => ({ ...face, shade: shade + (face.shade % 2) })),
}));

export const coverMesh = createTerrainMesh(coverRows);
export const ridgeMesh = createTerrainMesh(ridgeRows);
export const studyMesh = studyMountainLayers.flatMap((layer) => layer.faces);

// Trail columns belong to the tessellation itself, rather than a road-shaped overlay.
export function waystationMesh(tall: boolean): TerrainFace[] {
  let mesh = createTerrainMesh(tall ? waystationTallRows : waystationWideRows);
  // Six columns per strip, two faces per column; the fourth column is the road.
  mesh = mesh.map((face, index) =>
    Math.floor(index / 2) % 6 === 3
      ? { ...face, material: 'trail', shade: Math.min(3, face.shade) }
      : face,
  );
  mesh = separateTerrainShades(mesh);
  const transform = (polygon: [number, number][]): [number, number][] =>
    tall ? polygon.map(([x, y]) => [x * 0.94 - 670, y * 0.94 + 192]) : polygon;
  const features: { polygon: [number, number][]; material: 'marker' | 'stone'; shade: number }[] = [
    {
      polygon: [
        [1182, 466],
        [1195, 466],
        [1195, 681],
        [1182, 681],
      ],
      material: 'marker',
      shade: 3,
    },
    {
      polygon: [
        [1142, 495],
        [1220, 487],
        [1241, 503],
        [1225, 521],
        [1145, 528],
      ],
      material: 'marker',
      shade: 1,
    },
    {
      polygon: [
        [1131, 548],
        [1152, 529],
        [1228, 538],
        [1225, 567],
        [1150, 560],
      ],
      material: 'marker',
      shade: 4,
    },
    {
      polygon: [
        [1228, 686],
        [1236, 665],
        [1270, 657],
        [1267, 683],
        [1248, 696],
      ],
      material: 'stone',
      shade: 2,
    },
    {
      polygon: [
        [1270, 657],
        [1298, 666],
        [1308, 689],
        [1280, 699],
        [1267, 683],
      ],
      material: 'stone',
      shade: 5,
    },
    {
      polygon: [
        [1238, 663],
        [1248, 645],
        [1274, 640],
        [1265, 673],
      ],
      material: 'stone',
      shade: 1,
    },
    {
      polygon: [
        [1274, 640],
        [1291, 649],
        [1293, 666],
        [1265, 673],
      ],
      material: 'stone',
      shade: 4,
    },
    {
      polygon: [
        [1250, 644],
        [1258, 626],
        [1279, 624],
        [1271, 650],
      ],
      material: 'stone',
      shade: 0,
    },
    {
      polygon: [
        [1279, 624],
        [1289, 640],
        [1271, 650],
      ],
      material: 'stone',
      shade: 3,
    },
  ];
  for (const feature of features)
    mesh = inlayTerrain(mesh, transform(feature.polygon), feature.material, feature.shade);
  return mesh;
}

export function snowfieldMesh(tall: boolean, steps: number[][]): TerrainFace[] {
  let mesh = createTerrainMesh(tall ? lifeTallRows : lifeWideRows);
  for (const [x, y, angle, scale] of steps as [number, number, number, number][]) {
    const radians = (angle * Math.PI) / 180;
    for (const [dx, dy] of [
      [-6, -7],
      [6, 7],
    ]) {
      const footprint = [
        [0, -6],
        [2.6, -2],
        [2.6, 4],
        [0, 6],
        [-2.6, 4],
        [-2.6, -2],
      ].map(([px, py]) => {
        const u = (px! + dx!) * scale;
        const v = (py! + dy!) * scale;
        return [
          x + u * Math.cos(radians) - v * Math.sin(radians),
          y + u * Math.sin(radians) + v * Math.cos(radians),
        ] as [number, number];
      });
      mesh = inlayTerrain(mesh, footprint, 'track', 4);
    }
  }
  return mesh;
}
