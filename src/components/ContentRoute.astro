---
import { render, type RenderResult } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import {
  byOrder,
  contentAlternates,
  formatDate,
  getContentIndex,
  isPublicContent,
  localizedLabel,
  newestFirst,
  routeFor,
  routes,
  type ArticleEntry,
  type LogEntry,
  type PageEntry,
  type RouteEntry,
} from '../lib/content';
import { localizedPath, type Locale } from '../i18n/config';
import ArticlePage from './content/ArticlePage.astro';
import ContentPage from './content/ContentPage.astro';
import ProfilePage from './content/ProfilePage.astro';
import FriendsPage from './content/FriendsPage.astro';
import ListingPage from './content/ListingPage.astro';

type SpecialRoute = 'articles' | 'projects' | 'log-index' | 'friends' | 'tools';

interface Props {
  locale: Locale;
  route?: RouteEntry;
  special?: SpecialRoute;
}

const { locale, route, special } = Astro.props;
const index = await getContentIndex();
const emptyLabel =
  locale === 'zh'
    ? '这里暂时还没有公开内容。'
    : locale === 'de'
      ? 'Noch keine Inhalte.'
      : 'Nothing published here yet.';

let title = 'iceaxing';
let description = '';
let alternatePaths: Partial<Record<Locale, string>> | undefined;
let jsonLd: Record<string, unknown> | undefined;

let articleEntry: ArticleEntry | LogEntry | undefined;
let pageEntry: PageEntry | undefined;
let Content: RenderResult['Content'] | undefined;
let headings: Array<{ depth: number; slug: string; text: string }> = [];
let readingScene: 'ridge' | 'field' | 'camp' = 'ridge';
let readingBreadcrumbs: Array<{ title: string; href: string }> = [];
let readingNeighbors: {
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
} = {};
let listing:
  | {
      title: string;
      description?: string;
      eyebrow?: string;
      cards: Array<{
        href: string;
        title: string;
        description?: string;
        eyebrow?: string;
        meta?: string;
        tags?: string[];
        kind?: 'project' | 'collection' | 'article';
      }>;
    }
  | undefined;
let listingScene: 'cover' | 'ridge' | 'field' | 'camp' = 'cover';
let listingParent: { title: string; href: string } | undefined;
let listingProgress: number | undefined;
let listingStatus: string | undefined;
let showFriends = false;
let pagefindType = route?.kind ?? 'page';
let pagefindCategory: string | undefined;

const publicArticles = newestFirst(
  index.articles.filter((entry) => entry.data.locale === locale && isPublicContent(entry.data)),
);
const publicLogs = newestFirst(
  index.logs.filter((entry) => entry.data.locale === locale && isPublicContent(entry.data)),
);

if (special) {
  const specialPath = special === 'log-index' ? '/log' : `/${special}`;
  alternatePaths = {
    zh: localizedPath('zh', specialPath),
    en: localizedPath('en', specialPath),
    de: localizedPath('de', specialPath),
  };
}

if (special === 'articles') {
  pagefindType = 'page';
  title = locale === 'zh' ? '全部文章' : locale === 'de' ? 'Alle Artikel' : 'All articles';
  description =
    locale === 'zh'
      ? '按发布时间排列的技术、项目与生活笔记。'
      : 'Technical, project, and life notes ordered by publication date.';
  listing = {
    title,
    description,
    cards: publicArticles.map((entry) => ({
      href: routeFor(entry.data.contentId, locale, 'article') ?? '#',
      title: entry.data.title,
      description: entry.data.excerpt,
      meta: formatDate(entry.data.publishedAt, locale),
      tags: entry.data.tags,
    })),
  };
} else if (special === 'projects') {
  listingScene = 'ridge';
  pagefindType = 'page';
  title = locale === 'zh' ? '项目' : locale === 'de' ? 'Projekte' : 'Projects';
  description =
    locale === 'zh'
      ? '正在推进与已经完成的长期工作。'
      : 'Long-running work in progress and completed.';
  listing = {
    title,
    description,
    cards: byOrder(index.projects).map((entry) => ({
      kind: 'project',
      href: routeFor(entry.data.projectId, locale, 'project') ?? '#',
      title: localizedLabel(entry, locale).title,
      description: localizedLabel(entry, locale).description,
      eyebrow: `${entry.data.status.toUpperCase()} · ${entry.data.progress}%`,
      tags: entry.data.tags,
    })),
  };
} else if (special === 'log-index') {
  listingScene = 'camp';
  pagefindType = 'page';
  title = locale === 'zh' ? '日志' : 'Log';
  description =
    locale === 'zh' ? '短记录、阶段进展与沿途见闻。' : 'Short notes, milestones, and observations.';
  listing = {
    title,
    description,
    cards: publicLogs.map((entry) => ({
      href: routeFor(entry.data.contentId, locale, 'log') ?? '#',
      title: entry.data.title,
      description: entry.data.excerpt,
      eyebrow: entry.data.category,
      meta: formatDate(entry.data.logDate, locale),
      tags: entry.data.tags,
    })),
  };
} else if (special === 'friends') {
  pagefindType = 'page';
  title = locale === 'zh' ? '友链' : 'Friends';
  description =
    locale === 'zh' ? '同行者与值得拜访的站点。' : 'Fellow travellers and sites worth visiting.';
  showFriends = true;
} else if (special === 'tools') {
  pagefindType = 'page';
  title = locale === 'zh' ? '在线工具' : locale === 'de' ? 'Werkzeuge' : 'Tools';
  description =
    locale === 'zh'
      ? '工程计算和专注工具将在后续阶段迁入。'
      : 'Engineering and focus tools will return in a later phase.';
  listing = {
    title,
    description,
    cards: [
      {
        href: localizedPath(locale, '/tools/pomodoro'),
        title: locale === 'zh' ? '番茄钟' : 'Pomodoro Timer',
        description:
          locale === 'zh'
            ? '本地保存、后台校时、循环统计和完成提醒。'
            : 'Local persistence, background correction, cycle statistics, and alerts.',
        eyebrow: 'FOCUS / TIMER',
      },
      {
        href: localizedPath(locale, '/tools/smith-chart'),
        title: locale === 'zh' ? '史密斯圆图' : 'Smith Chart',
        description:
          locale === 'zh'
            ? '阻抗与导纳、传输线变换、标记、匹配计算和导出。'
            : 'Impedance, admittance, transmission lines, matching, markers, and export.',
        eyebrow: 'RF / ENGINEERING',
      },
    ],
  };
} else if (route?.kind === 'article' || route?.kind === 'log') {
  articleEntry =
    route.kind === 'article'
      ? index.articles.find((entry) => entry.data.contentId === route.contentId)
      : index.logs.find((entry) => entry.data.contentId === route.contentId);
  if (!articleEntry) throw new Error(`Missing content entry: ${route.contentId}`);
  if (route.kind === 'article') {
    const article = articleEntry as ArticleEntry;
    const collection = index.series.find(
      (entry) => entry.data.collectionId === article.data.collection,
    );
    const project = index.projects.find(
      (entry) => entry.data.projectId === (article.data.project ?? collection?.data.project),
    );
    const category = index.categories.find(
      (entry) => entry.data.categoryId === (article.data.category ?? project?.data.category),
    );
    pagefindCategory = category?.data.categoryId;
    readingScene = category?.data.tags.includes('daily-ramblings')
      ? 'camp'
      : category?.data.group === 'life'
        ? 'field'
        : 'ridge';
    const parents = [
      category && { entry: category, id: category.data.categoryId, kind: 'category' as const },
      project && { entry: project, id: project.data.projectId, kind: 'project' as const },
      collection && {
        entry: collection,
        id: collection.data.collectionId,
        kind: 'collection' as const,
      },
    ];
    readingBreadcrumbs = parents.flatMap((parent) => {
      if (!parent) return [];
      const href = routeFor(parent.id, locale, parent.kind);
      return href ? [{ title: localizedLabel(parent.entry, locale).title, href }] : [];
    });
    const siblings = byOrder(
      publicArticles.filter((entry) => {
        if (article.data.collection) return entry.data.collection === article.data.collection;
        if (project) return entry.data.project === project.data.projectId;
        if (category) return entry.data.category === category.data.categoryId;
        return false;
      }),
    );
    const currentIndex = siblings.findIndex(
      (entry) => entry.data.contentId === article.data.contentId,
    );
    const neighbor = (entry: ArticleEntry | undefined) => {
      const href = entry && routeFor(entry.data.contentId, locale, 'article');
      return entry && href ? { title: entry.data.title, href } : undefined;
    };
    if (currentIndex >= 0)
      readingNeighbors = {
        previous: neighbor(siblings[currentIndex - 1]),
        next: neighbor(siblings[currentIndex + 1]),
      };
  } else {
    readingScene = 'camp';
    readingBreadcrumbs = [
      { title: locale === 'zh' ? '日志' : 'Log', href: localizedPath(locale, '/log') },
    ];
  }
  const rendered = await render(articleEntry);
  Content = rendered.Content;
  headings = rendered.headings;
  title = articleEntry.data.seo.title || articleEntry.data.title;
  description = articleEntry.data.seo.description || articleEntry.data.excerpt;
  alternatePaths = contentAlternates(
    articleEntry.data.translationKey,
    route.kind,
    route.kind === 'article' ? index.articles : index.logs,
  );
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleEntry.data.title,
    description,
    datePublished: articleEntry.data.publishedAt.toISOString(),
    dateModified: (articleEntry.data.updatedAt ?? articleEntry.data.publishedAt).toISOString(),
    author: { '@type': 'Person', name: articleEntry.data.authorName },
    mainEntityOfPage: new URL(route.pathname, Astro.site ?? Astro.url.origin).href,
  };
} else if (route?.kind === 'page') {
  pageEntry = index.pages.find((entry) => entry.data.contentId === route.contentId);
  if (!pageEntry) throw new Error(`Missing page entry: ${route.contentId}`);
  const rendered = await render(pageEntry);
  Content = rendered.Content;
  headings = rendered.headings;
  title = pageEntry.data.seo.title || pageEntry.data.title;
  description = pageEntry.data.seo.description || pageEntry.data.excerpt;
  alternatePaths = contentAlternates(pageEntry.data.translationKey, 'page', index.pages);
} else if (route?.kind === 'category') {
  const category = index.categories.find((entry) => entry.data.categoryId === route.contentId);
  if (!category) throw new Error(`Missing category: ${route.contentId}`);
  pagefindCategory = category.data.categoryId;
  const label = localizedLabel(category, locale);
  listingScene = category.data.tags.includes('daily-ramblings')
    ? 'camp'
    : category.data.group === 'life'
      ? 'field'
      : 'ridge';
  title = label.title;
  description = label.description;
  alternatePaths = Object.fromEntries(
    routes
      .filter((item) => item.kind === 'category' && item.contentId === route.contentId)
      .map((item) => [item.locale, item.pathname]),
  );
  const projects = byOrder(
    index.projects.filter((entry) => entry.data.category === category.data.categoryId),
  );
  const articles = publicArticles.filter(
    (entry) =>
      entry.data.category === category.data.categoryId ||
      (category.data.tags.includes('daily-ramblings') &&
        entry.data.tags.includes('daily-ramblings')),
  );
  listing = {
    title,
    description,
    eyebrow: 'ICEAXING / CATEGORY',
    cards: [
      ...projects.map((entry) => ({
        kind: 'project' as const,
        href: routeFor(entry.data.projectId, locale, 'project') ?? '#',
        title: localizedLabel(entry, locale).title,
        description: localizedLabel(entry, locale).description,
        eyebrow: `${entry.data.status.toUpperCase()} · ${entry.data.progress}%`,
        tags: entry.data.tags,
      })),
      ...articles.map((entry) => ({
        kind: 'article' as const,
        href: routeFor(entry.data.contentId, locale, 'article') ?? '#',
        title: entry.data.title,
        description: entry.data.excerpt,
        eyebrow: 'ARTICLE',
        meta: formatDate(entry.data.publishedAt, locale),
        tags: entry.data.tags,
      })),
    ],
  };
} else if (route?.kind === 'project') {
  listingScene = 'ridge';
  const project = index.projects.find((entry) => entry.data.projectId === route.contentId);
  if (!project) throw new Error(`Missing project: ${route.contentId}`);
  pagefindCategory = project.data.category;
  const label = localizedLabel(project, locale);
  const category = index.categories.find(
    (entry) => entry.data.categoryId === project.data.category,
  );
  listingScene = category?.data.tags.includes('daily-ramblings')
    ? 'camp'
    : category?.data.group === 'life'
      ? 'field'
      : 'ridge';
  listingProgress = project.data.progress;
  listingStatus = project.data.status;
  if (category)
    listingParent = {
      title: localizedLabel(category, locale).title,
      href: routeFor(category.data.categoryId, locale, 'category') ?? localizedPath(locale),
    };
  title = label.title;
  description = label.description;
  alternatePaths = Object.fromEntries(
    routes
      .filter((item) => item.kind === 'project' && item.contentId === route.contentId)
      .map((item) => [item.locale, item.pathname]),
  );
  const collections = byOrder(
    index.series.filter((entry) => entry.data.project === project.data.projectId),
  );
  const articles = publicArticles.filter((entry) => entry.data.project === project.data.projectId);
  listing = {
    title,
    description,
    eyebrow: `ICEAXING / PROJECT · ${project.data.progress}%`,
    cards: [
      ...collections.map((entry) => ({
        kind: 'collection' as const,
        href: routeFor(entry.data.collectionId, locale, 'collection') ?? '#',
        title: localizedLabel(entry, locale).title,
        description: localizedLabel(entry, locale).description,
        eyebrow: 'COLLECTION',
        tags: entry.data.tags,
      })),
      ...articles.map((entry) => ({
        kind: 'article' as const,
        href: routeFor(entry.data.contentId, locale, 'article') ?? '#',
        title: entry.data.title,
        description: entry.data.excerpt,
        eyebrow: 'ARTICLE',
        meta: formatDate(entry.data.publishedAt, locale),
        tags: entry.data.tags,
      })),
    ],
  };
} else if (route?.kind === 'collection') {
  listingScene = 'field';
  const collection = index.series.find((entry) => entry.data.collectionId === route.contentId);
  if (!collection) throw new Error(`Missing collection: ${route.contentId}`);
  pagefindCategory = index.projects.find(
    (entry) => entry.data.projectId === collection.data.project,
  )?.data.category;
  const label = localizedLabel(collection, locale);
  const project = index.projects.find((entry) => entry.data.projectId === collection.data.project);
  const category = index.categories.find(
    (entry) => entry.data.categoryId === project?.data.category,
  );
  listingScene = category?.data.tags.includes('daily-ramblings')
    ? 'camp'
    : category?.data.group === 'life'
      ? 'field'
      : 'ridge';
  if (project)
    listingParent = {
      title: localizedLabel(project, locale).title,
      href: routeFor(project.data.projectId, locale, 'project') ?? localizedPath(locale),
    };
  title = label.title;
  description = label.description;
  alternatePaths = Object.fromEntries(
    routes
      .filter((item) => item.kind === 'collection' && item.contentId === route.contentId)
      .map((item) => [item.locale, item.pathname]),
  );
  listing = {
    title,
    description,
    eyebrow: 'ICEAXING / COLLECTION',
    cards: byOrder(
      publicArticles.filter((entry) => entry.data.collection === collection.data.collectionId),
    ).map((entry) => ({
      href: routeFor(entry.data.contentId, locale, 'article') ?? '#',
      title: entry.data.title,
      description: entry.data.excerpt,
      meta: formatDate(entry.data.publishedAt, locale),
      tags: entry.data.tags,
    })),
  };
}

const documentTitle = title === 'iceaxing' ? title : `${title} · iceaxing`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const homeLabel = locale === 'zh' ? '首页' : locale === 'de' ? 'Startseite' : 'Home';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: homeLabel,
      item: new URL(localizedPath(locale), Astro.site ?? Astro.url.origin).href,
    },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
const structuredData = jsonLd ? [jsonLd, breadcrumbLd] : breadcrumbLd;
---

<BaseLayout
  {locale}
  title={documentTitle}
  {description}
  type={articleEntry ? 'article' : 'website'}
  publishedAt={articleEntry?.data.publishedAt}
  {alternatePaths}
  jsonLd={structuredData}
  {pagefindType}
  {pagefindCategory}
>
  {articleEntry && Content ? (
    <ArticlePage
      entry={articleEntry}
      {locale}
      {headings}
      {Content}
      kind={route?.kind === 'log' ? 'log' : 'article'}
      scene={readingScene}
      breadcrumbs={readingBreadcrumbs}
      neighbors={readingNeighbors}
    />
  ) : pageEntry && Content ? (
    pageEntry.data.pageKind === 'profile' ? (
      <ProfilePage
        entry={pageEntry}
        {Content}
        {headings}
        {locale}
        authorName={index.settings[0]?.data.authorName ?? 'iceaxing'}
      />
    ) : (
      <ContentPage entry={pageEntry} {Content} {headings} {locale} />
    )
  ) : showFriends ? (
    <FriendsPage {locale} friends={byOrder(index.friends.filter((entry) => entry.data.active))} />
  ) : listing ? (
    <ListingPage
      {...listing}
      {locale}
      scene={listingScene}
      kind={
        route?.kind === 'category' || route?.kind === 'project' || route?.kind === 'collection'
          ? route.kind
          : 'index'
      }
      parent={listingParent}
      progress={listingProgress}
      status={listingStatus}
      {emptyLabel}
    />
  ) : null}
</BaseLayout>
