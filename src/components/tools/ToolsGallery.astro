---
import type { Locale } from '../../i18n/config';
import { getGalleryTools, galleryCopy, galleryCategories } from '../../lib/tools/gallery';
import { artwork, accent } from '../../lib/tools/gallery-art';
import '../../styles/tools-gallery.css';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tools = getGalleryTools(locale),
  copy = galleryCopy[locale];
---

<main id="main-content" class="tg-page" data-pagefind-body>
  <tools-gallery>
    <header class="tg-hero">
      <div class="tg-hero-copy">
        <p class="tg-eyebrow">{copy.eyebrow}</p>
        <h1 data-pagefind-meta="title">
          <span class="sr-only">{copy.title} — </span>
          {copy.heading[0]}
          <br />
          {copy.heading[1]}
        </h1>
        <p class="tg-hero-description">
          {copy.description[0]}
          <br class="tg-desktop-break" />
          {copy.description[1]}
        </p>
      </div>
      <div class="tg-hero-art" style="--card-accent:var(--accent)" aria-hidden="true">
        <Fragment set:html={artwork('stack-stones')} />
        <span>A SMALL PLAYGROUND / OPEN POSSIBILITIES</span>
      </div>
    </header>
    <section class="tg-gallery" aria-label={copy.title}>
      <div class="tg-toolbar" data-pagefind-ignore>
        <div class="tg-filters" role="group" aria-label={copy.title}>
          {galleryCategories.map((category) => (
            <button
              type="button"
              data-filter={category}
              aria-pressed={category === 'all' ? 'true' : 'false'}
            >
              {copy.categories[category]}
            </button>
          ))}
        </div>
        <div class="tg-search" role="search">
          <label for="tools-gallery-search">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="6" />
              <path d="m15 15 5 5" />
            </svg>
            <span class="sr-only">{copy.search}</span>
          </label>
          <input
            id="tools-gallery-search"
            type="search"
            placeholder={copy.search}
            autocomplete="off"
          />
        </div>
        <span class="tg-count" role="status" aria-live="polite">
          <span data-count>{tools.length}</span> {copy.count}
        </span>
      </div>
      <div class="tg-grid">
        {tools.map((tool, index) => (
          <article
            class="tg-card"
            data-category={tool.category}
            data-search={`${tool.title} ${tool.description} ${tool.id} ${copy.categories[tool.category]}`}
            style={`--card-accent:${accent(tool.id)}`}
          >
            <a class="tg-link" href={tool.href}>
              <figure class="tg-art" aria-hidden="true">
                <Fragment set:html={artwork(tool.id)} />
              </figure>
              <div class="tg-copy">
                <span class="tg-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="tg-category">{copy.categories[tool.category]}</p>
                <h2>
                  {tool.title}
                  <span aria-hidden="true">↗</span>
                </h2>
                <p class="tg-description">{tool.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p class="tg-empty" hidden>
        {copy.empty}
      </p>
    </section>
    <div class="tg-ending" aria-hidden="true">
      <span>{copy.footer}</span>
      <span>ICEAXING / TOOLS & CURIOSITIES</span>
    </div>
  </tools-gallery>
</main>
<script>
  import '../../scripts/tools-gallery';
</script>
