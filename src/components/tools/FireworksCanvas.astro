---
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const label = {
  zh: '点击或轻触任意位置放烟花，也可以按回车或空格键在中央放烟花。',
  en: 'Click or tap anywhere to launch fireworks. Press Enter or Space to launch at the center.',
  de: 'Klicke oder tippe, um Feuerwerk zu starten. Eingabe oder Leertaste startet es in der Mitte.',
}[locale];
---

<fireworks-sky>
  <canvas tabindex="0" role="button" aria-label={label}>
    {label}
  </canvas>
</fireworks-sky>

<style is:global>
  .tool-page.tool-page-fireworks {
    padding: 0;
    background: #05070e;
  }
  fireworks-sky,
  fireworks-sky canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  fireworks-sky canvas {
    cursor: crosshair;
    touch-action: manipulation;
  }
  fireworks-sky canvas:focus-visible {
    outline: 2px solid #98caff;
    outline-offset: -4px;
  }
</style>

<script>
  type Rocket = {
    startX: number;
    startY: number;
    x: number;
    y: number;
    age: number;
    duration: number;
    hue: number;
  };
  type Spark = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    age: number;
    life: number;
    hue: number;
    size: number;
  };

  class FireworksSky extends HTMLElement {
    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const context = canvas?.getContext('2d');
      if (!canvas || !context) return;

      let width = 0;
      let height = 0;
      let frame = 0;
      let previousTime = 0;
      let rockets: Rocket[] = [];
      let sparks: Spark[] = [];
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const events = new AbortController();
      const { signal } = events;

      const clear = () => context.clearRect(0, 0, width, height);
      const stop = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        previousTime = 0;
        rockets = [];
        sparks = [];
        clear();
      };
      const resize = () => {
        const bounds = canvas.getBoundingClientRect();
        width = bounds.width;
        height = bounds.height;
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        stop();
      };
      const burst = (rocket: Rocket) => {
        const count = reducedMotion.matches ? 36 : 120;
        const speed = Math.min(width, height) * (0.17 + Math.random() * 0.08);
        for (let index = 0; index < count; index++) {
          const angle = (index / count) * Math.PI * 2 + Math.random() * 0.05;
          const velocity = speed * (0.3 + Math.pow(Math.random(), 0.3) * 0.7);
          sparks.push({
            x: rocket.x,
            y: rocket.y,
            vx: Math.cos(angle) * velocity,
            vy: Math.sin(angle) * velocity,
            age: 0,
            life: reducedMotion.matches ? 0.6 : 1.4 + Math.random() * 1.1,
            hue: rocket.hue + Math.random() * 35 - 17,
            size: 0.8 + Math.random() * 1.3,
          });
        }
        // Bound work even when many fingers or rapid clicks launch together.
        if (sparks.length > 2400) sparks.splice(0, sparks.length - 2400);
      };
      const draw = (time: number) => {
        const dt = Math.min((time - previousTime) / 1000 || 1 / 60, 0.04);
        previousTime = time;
        clear();
        context.globalCompositeOperation = 'lighter';
        context.lineCap = 'round';

        rockets = rockets.filter((rocket) => {
          rocket.age += dt;
          const progress = Math.min(rocket.age / rocket.duration, 1);
          const ease = (value: number) => 1 - Math.pow(1 - value, 2);
          const head = ease(progress);
          const tail = ease(Math.max(0, progress - 0.12));
          const x = rocket.startX + (rocket.x - rocket.startX) * head;
          const y = rocket.startY + (rocket.y - rocket.startY) * head;
          const tailX = rocket.startX + (rocket.x - rocket.startX) * tail;
          const tailY = rocket.startY + (rocket.y - rocket.startY) * tail;
          const gradient = context.createLinearGradient(tailX, tailY, x, y + 0.01);
          gradient.addColorStop(0, `hsla(${rocket.hue}, 100%, 70%, 0)`);
          gradient.addColorStop(1, `hsla(${rocket.hue}, 100%, 85%, 1)`);
          context.strokeStyle = gradient;
          context.lineWidth = 2;
          context.beginPath();
          context.moveTo(tailX, tailY);
          context.lineTo(x, y);
          context.stroke();
          context.fillStyle = '#fff4d6';
          context.beginPath();
          context.arc(x, y, 2, 0, Math.PI * 2);
          context.fill();
          if (progress === 1) burst(rocket);
          return progress < 1;
        });

        sparks = sparks.filter((spark) => {
          spark.age += dt;
          if (spark.age >= spark.life) return false;
          const lastX = spark.x;
          const lastY = spark.y;
          const drag = Math.exp(-1.3 * dt);
          spark.vx *= drag;
          spark.vy = spark.vy * drag + 48 * dt;
          spark.x += spark.vx * dt;
          spark.y += spark.vy * dt;
          const alpha = Math.pow(1 - spark.age / spark.life, 1.4);
          context.strokeStyle = `hsla(${spark.hue}, 95%, 70%, ${alpha})`;
          context.lineWidth = spark.size;
          context.beginPath();
          context.moveTo(lastX - spark.vx * 0.025, lastY - spark.vy * 0.025);
          context.lineTo(spark.x, spark.y);
          context.stroke();
          return true;
        });
        context.globalCompositeOperation = 'source-over';
        if (rockets.length || sparks.length) frame = requestAnimationFrame(draw);
        else {
          clear();
          frame = 0;
          previousTime = 0;
        }
      };
      const launch = (x: number, y: number) => {
        if (!width || !height || document.hidden) return;
        rockets.push({
          startX: Math.max(0, Math.min(width, x + (Math.random() - 0.5) * width * 0.25)),
          startY: height + 8,
          x,
          y,
          age: 0,
          duration: reducedMotion.matches ? 0.25 : 0.65 + ((height - y) / height) * 0.55,
          hue: Math.random() * 360,
        });
        if (rockets.length > 20) rockets.shift();
        if (!frame) {
          previousTime = performance.now();
          frame = requestAnimationFrame(draw);
        }
      };

      canvas.addEventListener(
        'click',
        (event) => {
          const bounds = canvas.getBoundingClientRect();
          launch(event.clientX - bounds.left, event.clientY - bounds.top);
        },
        { signal },
      );
      canvas.addEventListener(
        'keydown',
        (event) => {
          if ((event.key === 'Enter' || event.key === ' ') && !event.repeat) {
            event.preventDefault();
            launch(width / 2, height / 2);
          }
        },
        { signal },
      );
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) stop();
        },
        { signal },
      );
      const observer = new ResizeObserver(resize);
      observer.observe(canvas);
      this.cleanup = () => {
        events.abort();
        observer.disconnect();
        stop();
      };
    }

    private cleanup?: () => void;

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('fireworks-sky')) customElements.define('fireworks-sky', FireworksSky);
</script>
