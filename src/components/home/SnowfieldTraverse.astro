---
import ChapterMarker from './ChapterMarker.astro';
import ScrollControls from './ScrollControls.astro';
import type { HomeCard, HomeLabels } from './types';

interface Props {
  labels: HomeLabels;
  categories: HomeCard[];
  latest: HomeCard[];
}

const { labels, categories, latest } = Astro.props;
---

<div class="journey-panel-inner journey-life-inner">
  <ChapterMarker number="03" altitude="5100m" label="SNOWFIELD" />
  <header class="journey-chapter-heading" data-reveal data-step="1">
    <p class="journey-eyebrow">BOOKS / JOURNEYS / ORDINARY DAYS</p>
    <h2 id="snowfield-traverse-title" tabindex="-1">
      {labels.chapters[2]}
    </h2>
    <p>{labels.chapterIntros[1]}</p>
  </header>

  <div class:list={['journey-life-content', { 'has-no-categories': categories.length === 0 }]}>
    {categories.length > 0 && (
      <nav class="journey-life-map" aria-label={labels.chapters[2]}>
        <div class="journey-section-label">
          <span>01</span>
          <p class="journey-eyebrow">FIELD INDEX</p>
          <ScrollControls target="life-category-list" label="FIELD INDEX" />
        </div>
        <div id="life-category-list" data-scroll-list tabindex="0">
          {categories.map((card, index) => (
            <a href={card.href} data-reveal data-step={String(2 + index)}>
              <span>0{index + 1}</span>
              <h3>{card.title}</h3>
              <small>{card.description}</small>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </nav>
    )}

    <section class="journey-latest" aria-labelledby="journey-latest-title">
      <div class="journey-section-label">
        <span>{categories.length > 0 ? '02' : '01'}</span>
        <h3 id="journey-latest-title">{labels.latest}</h3>
        <ScrollControls target="life-latest-list" label={labels.latest} />
      </div>
      <div id="life-latest-list" data-scroll-list tabindex="0">
        {latest.map((card, index) => (
          <a href={card.href} data-reveal data-step={String(3 + index)}>
            <span>0{index + 1}</span>
            <div>
              <small>{card.meta}</small>
              <strong>{card.title}</strong>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </section>
  </div>
</div>
