---
import TerrainFacets from './TerrainFacets.astro';
import { snowfieldMesh } from '../../data/terrain-scenes';

// Paired footprints shrink towards the distant pass; each layout has its own trail.
const wideSteps = [
  [152, 787, 59, 1.15],
  [217, 751, 62, 1.1],
  [285, 718, 67, 1.05],
  [357, 690, 74, 1],
  [432, 672, 82, 0.96],
  [507, 663, 88, 0.92],
  [582, 658, 81, 0.88],
  [653, 643, 66, 0.83],
  [718, 611, 49, 0.78],
  [767, 563, 46, 0.73],
  [811, 518, 57, 0.68],
  [864, 487, 72, 0.63],
  [922, 468, 76, 0.58],
  [978, 452, 67, 0.53],
  [1029, 427, 56, 0.48],
  [1070, 395, 56, 0.43],
  [1108, 370, 67, 0.38],
  [1144, 355, 74, 0.33],
];
const tallSteps = [
  [95, 1192, 28, 1.15],
  [125, 1139, 38, 1.08],
  [167, 1093, 53, 1],
  [221, 1060, 67, 0.94],
  [278, 1037, 66, 0.88],
  [329, 1006, 44, 0.82],
  [360, 961, 21, 0.76],
  [376, 909, 14, 0.7],
  [388, 858, 25, 0.64],
  [410, 815, 34, 0.59],
  [435, 773, 20, 0.54],
  [448, 727, 8, 0.49],
  [452, 682, 12, 0.44],
  [462, 641, 26, 0.39],
  [479, 606, 34, 0.34],
];
const layouts = [
  { name: 'wide', width: 1440, height: 800, faces: snowfieldMesh(false, wideSteps) },
  { name: 'tall', width: 600, height: 1200, faces: snowfieldMesh(true, tallSteps) },
];
---

{layouts.map(({ name, width, height, faces }) => (
  <svg
    class={`journey-landscape life-library-landscape snowfield-${name}`}
    data-reveal="landscape"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <TerrainFacets {faces} />
  </svg>
))}
