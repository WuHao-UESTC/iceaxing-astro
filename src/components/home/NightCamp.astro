---
import ChapterMarker from './ChapterMarker.astro';
import type { HomeCard, HomeLabels } from './types';

interface Props {
  labels: HomeLabels;
  notes: HomeCard[];
  entries: HomeCard[];
}

const { labels, notes, entries } = Astro.props;
---

<div class="journey-panel-inner journey-night-inner">
  <ChapterMarker number="04" altitude="6200m" label="NIGHT CAMP" />
  <header class="journey-chapter-heading" data-reveal data-step="1">
    <p class="journey-eyebrow">MOMENTS / PEOPLE / PLACES</p>
    <h2 id="night-camp-title" tabindex="-1">
      {labels.chapters[3]}
    </h2>
    <p>{labels.chapterIntros[2]}</p>
  </header>

  <div class="journey-camp-grid">
    <section aria-labelledby="field-notes-title">
      <div class="journey-section-label">
        <span>01</span>
        <h3 id="field-notes-title">{labels.fieldNotes}</h3>
      </div>
      <div class="journey-notes">
        {notes.map((card, index) => (
          <a href={card.href} data-reveal data-step={String(2 + index)}>
            <span>0{index + 1}</span>
            <div>
              <small>{card.meta}</small>
              <h4>{card.title}</h4>
              <p>{card.description}</p>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </section>

    <aside class="journey-directory" aria-labelledby="camp-directory-title">
      <div class="journey-section-label">
        <span>02</span>
        <h3 id="camp-directory-title">{labels.directory}</h3>
      </div>
      <div>
        {entries.map((card, index) => (
          <a href={card.href} data-reveal data-step={String(3 + index)}>
            <span>0{index + 1}</span>
            <strong>{card.title}</strong>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </aside>
  </div>
</div>
