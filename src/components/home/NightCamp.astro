---
import type { Locale } from '../../i18n/config';
import '../../styles/waystation-notes.css';
import ChapterMarker from './ChapterMarker.astro';
import WaystationLandscape from './WaystationLandscape.astro';
import type { HomeCard, HomeLabels } from './types';

interface Props {
  labels: HomeLabels;
  locale: Locale;
  notes: HomeCard[];
  entries: HomeCard[];
  ramblingsHref: string;
}
const { labels, locale, notes, entries, ramblingsHref } = Astro.props;
const copy =
  locale === 'zh'
    ? {
        latest: '碎碎念',
        archive: '翻看全部随记',
        empty: '路过这里，留一点念想。',
        emptyText: '旅途还在继续，下一则随记正在路上。',
        foot: '短暂停靠，再继续出发。',
        undated: '未标注日期',
      }
    : locale === 'de'
      ? {
          latest: 'Lose Gedanken',
          archive: 'Alle Gedanken lesen',
          empty: 'Ein Gedanke für unterwegs.',
          emptyText: 'Die Reise geht weiter. Die nächste Notiz folgt.',
          foot: 'Kurz verweilen. Dann weitergehen.',
          undated: 'Ohne Datum',
        }
      : {
          latest: 'Ramblings',
          archive: 'Browse all ramblings',
          empty: 'Leave a thought along the way.',
          emptyText: 'The journey continues. The next note is on its way.',
          foot: 'A brief stop. Then onwards.',
          undated: 'Undated',
        };
---

<WaystationLandscape />
<div class="station-ladder" aria-hidden="true"></div>
<div class="journey-panel-inner journey-night-inner station-inner">
  <ChapterMarker number="05" altitude="6200m" label="TRAIL WAYSTATION" />
  <header class="journey-chapter-heading" data-reveal data-step="1">
    <p class="journey-eyebrow">MOMENTS / PEOPLE / PLACES</p>
    <h2 id="night-camp-title" tabindex="-1">
      {labels.chapters[4]}
    </h2>
    <p>{labels.chapterIntros[3]}</p>
  </header>
  <div class="station-scene">
    <nav class="station-stops" aria-label={labels.directory}>
      {entries.map((card, index) => (
        <a
          class="station-stop"
          href={card.href}
          style={`--stop-index:${index}`}
          data-reveal
          data-step={String(2 + index)}
        >
          <span class="station-stop-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <strong>{card.title}</strong>
          <span class="station-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </nav>
    <section
      class="station-journal"
      aria-labelledby="station-journal-title"
      data-reveal
      data-step="2"
    >
      <div class="station-journal-heading">
        <h3 id="station-journal-title">{copy.latest}</h3>
        <a href={ramblingsHref}>
          {copy.archive}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div
        class="station-timeline"
        tabindex="0"
        role="region"
        aria-labelledby="station-journal-title"
      >
        {notes.length > 0 ? (
          <ol class="station-journal-list">
            {notes.map((card) => (
              <li>
                <a href={card.href}>
                  <time datetime={card.publishedAt}>{card.meta || copy.undated}</time>
                  <h4>{card.title}</h4>
                  {card.description && <p>{card.description}</p>}
                  <span class="station-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="station-rest">
            <p>{copy.empty}</p>
            <span>{copy.emptyText}</span>
          </div>
        )}
      </div>
    </section>
  </div>
  <footer class="station-footer">
    <span>{copy.foot}</span>
    <a href="#base-camp">
      {labels.back}
      <span aria-hidden="true">↑</span>
    </a>
  </footer>
</div>
