---
import ChapterMarker from './ChapterMarker.astro';
import ScrollControls from './ScrollControls.astro';
import type { HomeCard, HomeLabels } from './types';

interface Props {
  labels: HomeLabels;
  categories: HomeCard[];
  projects: HomeCard[];
}

const { labels, categories, projects } = Astro.props;
---

<div class="journey-panel-inner journey-technical-inner">
  <ChapterMarker number="02" altitude="4200m" label="TECHNICAL RIDGE" />
  <header class="journey-chapter-heading" data-reveal data-step="1">
    <p class="journey-eyebrow">TOOLS / SYSTEMS / CRAFT</p>
    <h2 id="technical-ridge-title" tabindex="-1">
      {labels.chapters[1]}
    </h2>
    <p>{labels.chapterIntros[0]}</p>
  </header>

  <div class="journey-technical-grid">
    <section class="journey-route-ledger" aria-labelledby="technical-categories-title">
      <div class="journey-section-label">
        <span>01</span>
        <h3 id="technical-categories-title">STACK INDEX</h3>
        <ScrollControls target="technical-category-list" label="STACK INDEX" />
      </div>
      <nav
        id="technical-category-list"
        class="journey-category-route"
        aria-label={labels.chapters[1]}
        data-scroll-list
        tabindex="0"
      >
        {categories.map((card, index) => (
          <a href={card.href} data-reveal data-step={String(2 + index)}>
            <span>0{index + 1}</span>
            <div>
              <h4>{card.title}</h4>
              <p>{card.description}</p>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </nav>
    </section>

    <section class="journey-projects" aria-labelledby="journey-projects-title">
      <div class="journey-section-label">
        <span>02</span>
        <h3 id="journey-projects-title">{labels.projects}</h3>
        <ScrollControls target="technical-project-list" label={labels.projects} />
      </div>
      <div id="technical-project-list" data-scroll-list tabindex="0">
        {projects.map((card, index) => (
          <a
            href={card.href}
            class="journey-project-card"
            data-reveal
            data-step={String(3 + index)}
          >
            <div class="journey-project-title">
              <small>{card.meta}</small>
              <h4>{card.title}</h4>
            </div>
            <p>{card.description}</p>
            <span class="journey-progress" aria-label={`${card.progress ?? 0}%`}>
              <i style={`width:${card.progress ?? 0}%`} />
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</div>
