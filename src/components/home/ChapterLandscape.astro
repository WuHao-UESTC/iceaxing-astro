---
import TerrainFacets from './TerrainFacets.astro';
import { coverMesh, ridgeMesh } from '../../data/terrain-scenes';

interface Props {
  scene: 'cover' | 'ridge';
}
const { scene } = Astro.props;
---

<svg
  class={`journey-landscape journey-landscape-${scene}`}
  data-reveal="landscape"
  viewBox="0 0 1440 800"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <TerrainFacets faces={scene === 'cover' ? coverMesh : ridgeMesh} />
  {scene === 'cover' ? (
    <>
      <g class="landscape-orbit landscape-orbit-cover">
        <path d="M1110 110L1148 126L1164 164L1148 202L1110 218L1072 202L1056 164L1072 126ZM1004 164H1216M1110 58V270" />
      </g>
      <g class="landscape-summit-flag">
        <path d="M1021 105V64" />
        <path d="M1022 66L1053 76L1022 87Z" />
      </g>
      <path
        class="landscape-expedition-route"
        d="M747 800L964 754L1094 701L1020 658L943 614L969 582L1022 569"
      />
    </>
  ) : (
    <>
      <path
        class="landscape-expedition-route"
        d="M347 752L480 664L555 557L620 483L699 427L761 351L851 292L976 250L1082 168"
      />
      <g class="landscape-survey-marks">
        <path d="M1062 168H1102M1082 148V188M831 292H871M851 272V312M679 427H719M699 407V447" />
      </g>
      <g class="landscape-route-dots">
        <circle cx="347" cy="752" r="4" />
        <circle cx="555" cy="557" r="4" />
        <circle cx="699" cy="427" r="4" />
        <circle cx="851" cy="292" r="4" />
        <circle cx="1082" cy="168" r="4" />
      </g>
    </>
  )}
</svg>
