      <g class="landscape-strata">
        <path d="M42 800C249 699 363 572 449 408C523 266 559 123 624 0" />
        <path d="M93 800C291 699 403 574 484 414C558 269 592 127 650 0" />
        <path d="M150 800C330 705 438 588 520 433C596 289 619 145 678 0" />
