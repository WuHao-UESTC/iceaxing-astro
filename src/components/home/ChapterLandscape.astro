      />
      <g class="landscape-summit-flag">
        <path d="M1021 105V64" />
        <path d="M1022 66L1053 76L1022 87Z" />
      </g>

      <g class="landscape-contours landscape-contours-cover">
        <path d="M646 613C773 557 835 474 911 391C966 331 1008 310 1056 323" />
        <path d="M719 650C846 594 900 508 976 433C1028 382 1085 374 1144 399" />
        <path d="M821 684C943 629 991 553 1060 499C1115 456 1190 459 1263 491" />
