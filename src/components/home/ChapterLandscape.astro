---
interface Props {
  scene: 'cover' | 'ridge' | 'field' | 'camp';
}

const { scene } = Astro.props;
---

<svg
  class={`journey-landscape journey-landscape-${scene}`}
  data-reveal="landscape"
  viewBox="0 0 1440 800"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {scene === 'cover' && (
    <>
      <circle class="landscape-sun" cx="1090" cy="170" r="52" />
      <path
        class="landscape-wash"
        d="M350 670C520 625 619 517 713 451C795 394 824 338 892 278C936 339 964 368 1007 399C1052 355 1103 277 1175 228C1241 321 1320 362 1440 403V800H350Z"
      />
