---
interface Props {
  scene: 'cover' | 'ridge' | 'field' | 'camp';
}

const { scene } = Astro.props;
---

<svg
  class={`journey-landscape journey-landscape-${scene}`}
  data-reveal="landscape"
  viewBox="0 0 1440 800"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {scene === 'cover' && (
    <>
      <g class="landscape-orbit landscape-orbit-cover">
        <circle cx="1110" cy="164" r="54" />
        <circle cx="1110" cy="164" r="82" />
        <path d="M1004 164H1216M1110 58V270" />
      </g>

      <g class="landscape-wind landscape-wind-cover">
        <path d="M684 128C795 95 907 100 998 132" />
        <path d="M741 158C829 135 905 139 966 158" />
        <path d="M76 684C206 650 304 660 417 697" />
      </g>

      <path
        class="landscape-mass landscape-mass-far"
        d="M286 704L542 566L708 438L820 337L891 269L953 331L1019 242L1115 344L1188 277L1292 396L1440 456V800H286Z"
      />
      <path
        class="landscape-mass landscape-mass-mid"
        d="M0 747C204 721 347 684 514 580C655 492 742 397 862 292C952 213 987 153 1021 105C1055 193 1099 263 1175 332C1241 392 1325 430 1440 447V800H0Z"
