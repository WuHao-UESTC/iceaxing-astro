        d="M0 722C230 711 410 677 579 570C699 494 773 390 875 295C955 219 983 157 1015 118C1051 196 1074 246 1150 319C1227 393 1320 443 1440 454V800H0Z"
      />
      <path
        class="landscape-line"
        pathLength="1"
        d="M410 655C665 565 767 394 875 295C955 219 983 157 1015 118"
      />
      <path
        class="landscape-front"
        d="M0 662C194 605 340 645 492 665C711 695 760 517 963 511C1150 506 1252 643 1440 563V800H0Z"
      />
