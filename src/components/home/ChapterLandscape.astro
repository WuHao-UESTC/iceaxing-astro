        d="M747 800C872 752 1086 759 1094 701C1100 656 942 659 943 614C944 584 985 574 1022 569"
      />
      <g class="landscape-route-dots">
        <circle cx="747" cy="800" r="3" />
        <circle cx="944" cy="614" r="3" />
        <circle cx="1094" cy="701" r="3" />
        <circle cx="1022" cy="569" r="3" />
      </g>
    </>
  )}

  {scene === 'ridge' && (
    <>
