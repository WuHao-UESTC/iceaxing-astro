  {scene === 'field' && (
    <>
      <g class="landscape-orbit landscape-orbit-field">
        <circle cx="236" cy="170" r="58" />
        <circle cx="236" cy="170" r="92" />
      </g>
      <g class="landscape-wind landscape-wind-field">
        <path d="M82 243C257 190 404 197 555 229" />
        <path d="M875 142C1059 95 1221 103 1376 150" />
        <path d="M937 187C1083 151 1221 160 1334 196" />
      </g>
      <g class="landscape-drift-particles">
        <circle cx="582" cy="174" r="3" />
        <circle cx="655" cy="128" r="2" />
        <circle cx="736" cy="202" r="2.5" />
        <circle cx="811" cy="151" r="2" />
        <circle cx="923" cy="237" r="3" />
        <circle cx="1052" cy="122" r="2" />
