        d="M133 800C260 712 421 760 585 716C738 674 716 571 820 524C916 480 891 372 1001 306C1115 239 1210 280 1328 166"
      />

      <g class="landscape-camp-glow">
        <circle cx="1216" cy="633" r="82" />
        <circle cx="1216" cy="633" r="38" />
