        d="M176 690C318 633 424 648 548 612S804 598 916 560S1124 502 1282 530"
      />
      <g class="landscape-track-marks">
        <ellipse cx="224" cy="671" rx="4" ry="8" transform="rotate(64 224 671)" />
        <ellipse cx="300" cy="649" rx="4" ry="8" transform="rotate(72 300 649)" />
        <ellipse cx="382" cy="643" rx="4" ry="8" transform="rotate(83 382 643)" />
        <ellipse cx="470" cy="630" rx="4" ry="8" transform="rotate(70 470 630)" />
        <ellipse cx="558" cy="611" rx="4" ry="8" transform="rotate(78 558 611)" />
        <ellipse cx="652" cy="604" rx="4" ry="8" transform="rotate(88 652 604)" />
        <ellipse cx="753" cy="594" rx="4" ry="8" transform="rotate(75 753 594)" />
        <ellipse cx="862" cy="576" rx="4" ry="8" transform="rotate(68 862 576)" />
      </g>
    </>
  )}

  {scene === 'camp' && (
    <>
      <g class="landscape-night-sky">
        <circle class="landscape-star landscape-star-lg" cx="187" cy="132" r="2" />
        <circle class="landscape-star" cx="305" cy="215" r="1.4" />
        <circle class="landscape-star" cx="447" cy="118" r="1.4" />
        <circle class="landscape-star landscape-star-lg" cx="612" cy="185" r="2" />
        <circle class="landscape-star" cx="739" cy="92" r="1.4" />
        <circle class="landscape-star" cx="878" cy="178" r="1.4" />
        <circle class="landscape-star landscape-star-lg" cx="1018" cy="102" r="2" />
        <circle class="landscape-star" cx="1168" cy="254" r="1.4" />
        <circle class="landscape-star" cx="1328" cy="142" r="1.4" />
      </g>
      <g class="landscape-constellation">
        <path d="M447 118L612 185L739 92L878 178L1018 102" />
        <circle cx="447" cy="118" r="3" />
        <circle cx="612" cy="185" r="3" />
        <circle cx="739" cy="92" r="3" />
        <circle cx="878" cy="178" r="3" />
        <circle cx="1018" cy="102" r="3" />
      </g>
      <g class="landscape-moon">
        <circle cx="1116" cy="222" r="70" />
