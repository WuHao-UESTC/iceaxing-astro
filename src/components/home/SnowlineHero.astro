---
import type { HomeCard, HomeLabels } from './types';

interface Props {
  labels: HomeLabels;
  motto?: { text: string; source: string };
  featured: HomeCard[];
  profileHref: string;
}

const { labels, motto, featured, profileHref } = Astro.props;
---

<div class="journey-panel-inner journey-hero-inner">
  <div class="journey-hero-copy">
    <p class="journey-eyebrow" data-reveal data-step="1">
      ICEAXING / ABOVE THE SNOWLINE
    </p>
    <h1 id="base-camp-title" tabindex="-1" data-reveal data-step="1">
      {labels.heroTitle[0]}
      <br />
      <span>{labels.heroTitle[1]}</span>
    </h1>
    <p class="journey-intro" data-reveal data-step="2">
      {labels.intro}
    </p>
    {motto && (
      <figure class="journey-motto" data-reveal data-step="2">
        <blockquote>{motto.text}</blockquote>
        {motto.source && <figcaption>— {motto.source}</figcaption>}
      </figure>
    )}
    <div class="journey-actions" data-reveal data-step="3">
      <a class="journey-button" href="#selected-notes">
        {labels.read}
        <span>↗</span>
      </a>
      <a class="journey-text-link" href={profileHref}>
        {labels.meet}
        <span>→</span>
      </a>
    </div>
  </div>

  <section
    id="selected-notes"
    class="journey-featured"
    aria-labelledby="selected-notes-title"
    tabindex="-1"
  >
    <header>
      <p class="journey-eyebrow">SELECTED NOTES</p>
      <h2 id="selected-notes-title">{labels.featured}</h2>
    </header>
    <div class="journey-featured-track">
      {featured.map((card, index) => (
        <a class="journey-featured-card" href={card.href} data-reveal data-step={String(4 + index)}>
          <span>0{index + 1}</span>
          <div>
            <small>{card.meta}</small>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </div>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>
</div>
