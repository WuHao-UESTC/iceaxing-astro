---
import ChapterMarker from './ChapterMarker.astro';
import ScrollControls from './ScrollControls.astro';
import type { HomeCard, HomeLabels } from './types';
import { localizedPath, type Locale } from '../../i18n/config';
import { getMessages } from '../../i18n/messages';

interface Props {
  locale: Locale;
  labels: HomeLabels;
  motto?: { text: string; source: string };
  featured: HomeCard[];
  destinations: HomeCard[];
  profileHref: string;
}

const { locale, labels, motto, featured, destinations, profileHref } = Astro.props;
const messages = getMessages(locale);
const routes = [
  { number: '02', label: labels.chapters[1], href: '#technical-ridge', id: 'technical-ridge' },
  {
    number: '03',
    label: labels.chapters[2],
    href: '#study-terrace',
    id: 'study-terrace',
  },
  {
    number: '04',
    label: labels.chapters[3],
    href: '#snowfield-traverse',
    id: 'snowfield-traverse',
  },
  { number: '05', label: labels.chapters[4], href: '#night-camp', id: 'night-camp' },
];
---

<div class="journey-panel-inner journey-hero-inner">
  <ChapterMarker number="01" altitude="3200m" label="BASE CAMP" />

  <div class="journey-hero-stage">
    <div class="journey-hero-copy">
      <p class="journey-eyebrow" data-reveal data-step="1">
        PERSONAL FIELD NOTES / ABOVE THE SNOWLINE
      </p>
      <h1 id="base-camp-title" tabindex="-1" data-reveal data-step="1">
        {labels.heroTitle}
      </h1>
      <p class="journey-intro" data-reveal data-step="2">
        {labels.intro}
      </p>
      {motto && (
        <figure class="journey-motto" data-reveal data-step="2">
          <blockquote>{motto.text}</blockquote>
          {motto.source && <figcaption>— {motto.source}</figcaption>}
        </figure>
      )}
      <div class="journey-hero-links" data-reveal data-step="3">
        <a class="journey-profile-link" href={profileHref}>
          {labels.meet}
          <span aria-hidden="true">↗</span>
        </a>
        <nav
          class="journey-hero-archives"
          aria-label={messages.nav.articles + ' / ' + messages.nav.projects}
        >
          <a href={localizedPath(locale, '/articles')}>
            {messages.nav.articles}
            <span aria-hidden="true">↗</span>
          </a>
          <a href={localizedPath(locale, '/projects')}>
            {messages.nav.projects}
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>

      <section
        id="selected-notes"
        class="journey-featured"
        aria-labelledby="selected-notes-title"
        tabindex="-1"
      >
        <header>
          <div>
            <p class="journey-eyebrow">SELECTED NOTES</p>
            <h2 id="selected-notes-title">{labels.featured}</h2>
          </div>
          <a href="#technical-ridge">
            {labels.next}
            <span aria-hidden="true">↓</span>
          </a>
          <ScrollControls target="hero-featured-list" label={labels.featured} />
        </header>
        <div id="hero-featured-list" class="journey-featured-track" data-scroll-list tabindex="0">
          {featured.map((card, index) => (
            <a
              class="journey-featured-card"
              href={card.href}
              data-reveal
              data-step={String(4 + index)}
            >
              <span>0{index + 1}</span>
              <div>
                <small>{card.meta}</small>
                <strong>{card.title}</strong>
              </div>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

  {destinations.length > 0 && (
    <nav class="journey-featured-destinations" aria-label={labels.featured}>
      {destinations.map((card, index) => (
        <a
          href={card.href}
          style={`--destination-index:${index}`}
          data-reveal
          data-step={String(2 + index)}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{card.title}</strong>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </nav>
  )}

  <nav class="journey-ridge-routes" aria-label={labels.route} data-reveal data-step="3">
    {routes.map((route, index) => (
      <a href={route.href} data-hero-route={route.id} style={`--route-index:${index}`}>
        <i aria-hidden="true" />
        <span>{route.number}</span>
        <strong>{route.label}</strong>
        <small aria-hidden="true">↗</small>
      </a>
    ))}
  </nav>
</div>
