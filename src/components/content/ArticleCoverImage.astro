---
import { Image } from 'astro:assets';
import type { ArticleCover } from '../../lib/article-cover';
interface Props {
  image: ArticleCover;
  class?: string;
  hero?: boolean;
  sizes?: string;
}
const { image, class: className, hero = false, sizes } = Astro.props;
---

{typeof image === 'string' ? (
  <img
    src={image}
    class={className}
    alt=""
    width="1200"
    height="600"
    loading={hero ? 'eager' : 'lazy'}
    fetchpriority={hero ? 'high' : 'auto'}
    decoding="async"
  />
) : (
  <Image
    src={image}
    class={className}
    alt=""
    widths={hero ? [640, 960, 1280, 1600] : [160, 320, 480]}
    sizes={
      sizes ??
      (hero ? '(max-width: 900px) calc(100vw - 2rem), 1024px' : '(max-width: 640px) 108px, 168px')
    }
    loading={hero ? 'eager' : 'lazy'}
    fetchpriority={hero ? 'high' : 'auto'}
    decoding="async"
  />
)}
