---
import type { ImageMetadata } from 'astro';
interface Props {
  image?: string | ImageMetadata;
  title: string;
  index: number;
  type: 'project' | 'research';
}
const { image, title, index, type } = Astro.props;
const source = typeof image === 'string' ? image : image?.src;
---

<div class="profile-postcard-aside">
  <span class="profile-postcard-number" aria-hidden="true">
    {String(index + 1).padStart(2, '0')} / FIELD NOTES
  </span>
  <div class="profile-postcard-visual">
    <svg
      viewBox="0 0 140 110"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {type === 'research' ? (
        <>
          <path d="M12 80h116M20 15v65M26 60l15-23 16 29 18-43 18 30 17-15 15 22" />
          <circle cx="75" cy="23" r="4" />
          <path d="M32 95h48m8 0h20" />
        </>
      ) : (
        <>
          <path d="M16 49h31m0-25 45 25-45 25ZM92 49h30M109 49V13H65v20M21 30v15m-7-7h14M17 68h12M30 95h80" />
          <path d="M109 49v37H28V49" stroke-dasharray="3 4" />
        </>
      )}
    </svg>
    {source && (
      <img
        src={source}
        alt={title}
        width="280"
        height="200"
        loading="lazy"
        decoding="async"
        data-profile-image
      />
    )}
  </div>
  <span class="profile-postcard-address" aria-hidden="true">
    ICEAXING
    <br />
    RESEARCH ARCHIVE
  </span>
  <span class="profile-postcard-rule" aria-hidden="true"></span>
  <span class="profile-postcard-rule short" aria-hidden="true"></span>
</div>
