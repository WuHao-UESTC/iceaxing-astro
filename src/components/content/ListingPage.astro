---
import { localizedPath, type Locale } from '../../i18n/config';
import { archiveStatistics } from '../../lib/archive-statistics';
import ArchiveStatisticArt from './ArchiveStatisticArt.astro';
import ArticleCoverImage from './ArticleCoverImage.astro';
import type { ArticleCover } from '../../lib/article-cover';
import {
  resolveFolderCover,
  folderThemeForScene,
  type FolderGroup,
  type FolderTheme,
} from '../../lib/folder-cover';
import FolderLandscape from './FolderLandscape.astro';
import '../../styles/listing.css';
import '../../styles/folder-covers.css';

interface Card {
  href: string;
  title: string;
  description?: string;
  eyebrow?: string;
  meta?: string;
  tags?: string[];
  kind?: 'project' | 'collection' | 'article';
  standalone?: boolean;
  cover?: ArticleCover;
  coverGroup?: FolderTheme;
}
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  cards: Card[];
  emptyLabel: string;
  scene?: 'cover' | 'ridge' | 'study' | 'field' | 'camp';
  kind?: 'category' | 'project' | 'collection' | 'index';
  locale: Locale;
  parent?: { title: string; href: string };
  progress?: number;
  status?: string;
  cover?: ArticleCover;
  folderGroup?: FolderGroup;
}

const {
  title,
  description,
  cards: sourceCards,
  emptyLabel,
  scene = 'ridge',
  kind = 'index',
  locale,
  parent,
  progress,
  status,
  cover,
  folderGroup,
} = Astro.props;
const coverGroup = scene === 'camp' ? 'camp' : (folderGroup ?? folderThemeForScene(scene));
const isFolder = kind !== 'index';
const heroCover = isFolder ? resolveFolderCover(cover, coverGroup) : undefined;
const groupCaption = {
  skill: 'TECHNICAL RIDGE',
  study: 'KNOWLEDGE ATLAS',
  life: 'SNOW MOUNTAIN RIFT',
  camp: 'TRAIL WAYSTATION',
}[coverGroup];
const cards = sourceCards.map((card) =>
  card.kind === 'article'
    ? { ...card, cover: card.cover || '/media/articles/cover-placeholder.svg' }
    : card.kind === 'project' || card.kind === 'collection'
      ? { ...card, cover: resolveFolderCover(card.cover, card.coverGroup ?? coverGroup) }
      : card,
);
const labels =
  locale === 'zh'
    ? {
        home: '首页',
        category: '主题索引',
        project: '项目手册',
        collection: '阅读目录',
        index: '内容索引',
        projectGroup: '项目',
        collectionGroup: '合集',
        articleGroup: '文章',
        standalone: '独立文章',
        statistics: '内容统计',
        entryGroup: '条目',
        contents: '本页目录',
        progress: '项目进度',
        overview: '概览',
        active: '进行中',
        completed: '已完成',
        paused: '已暂停',
        planned: '计划中',
        archived: '已归档',
      }
    : locale === 'de'
      ? {
          home: 'Start',
          category: 'Themenindex',
          project: 'Projekthandbuch',
          collection: 'Lesereihe',
          index: 'Inhalte',
          projectGroup: 'Projekte',
          collectionGroup: 'Sammlungen',
          articleGroup: 'Artikel',
          standalone: 'Einzelartikel',
          statistics: 'Inhaltsstatistik',
          entryGroup: 'Einträge',
          contents: 'Inhalt',
          progress: 'Fortschritt',
          overview: 'Überblick',
          active: 'In Arbeit',
          completed: 'Abgeschlossen',
          paused: 'Pausiert',
          planned: 'Geplant',
          archived: 'Archiviert',
        }
      : {
          home: 'Home',
          category: 'Subject index',
          project: 'Project notebook',
          collection: 'Reading sequence',
          index: 'Content index',
          projectGroup: 'Projects',
          collectionGroup: 'Collections',
          articleGroup: 'Articles',
          standalone: 'Standalone articles',
          statistics: 'Content statistics',
          entryGroup: 'Entries',
          contents: 'On this page',
          progress: 'Project progress',
          overview: 'Overview',
          active: 'In progress',
          completed: 'Completed',
          paused: 'Paused',
          planned: 'Planned',
          archived: 'Archived',
        };
const groups = (['project', 'collection', 'article', 'entry'] as const)
  .map((type) => ({
    type,
    title: labels[`${type}Group`],
    cards: cards.filter(
      (card) => (card.kind ?? (kind === 'collection' ? 'article' : 'entry')) === type,
    ),
  }))
  .filter((group) => group.cards.length > 0);
const statusLabel = status
  ? ({
      active: labels.active,
      completed: labels.completed,
      paused: labels.paused,
      planned: labels.planned,
      archived: labels.archived,
    }[status] ?? status)
  : undefined;
const statistics = archiveStatistics(kind, cards).map((statistic) => ({
  ...statistic,
  label:
    statistic.type === 'article' && (kind === 'category' || kind === 'project')
      ? labels.standalone
      : labels[`${statistic.type}Group`],
}));
---

<main
  id="main-content"
  class={`archive-page archive-${kind} archive-tone-${scene}${isFolder ? ` archive-folder-group-${coverGroup}` : ''} shell`}
  data-pagefind-body
>
  <nav class="archive-breadcrumb" aria-label={labels.overview}>
    <a href={localizedPath(locale, '/blog')}>{labels.home}</a>
    {parent && (
      <>
        <span aria-hidden="true">/</span>
        <a href={parent.href}>{parent.title}</a>
      </>
    )}
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>
  <header class:list={['archive-heading', { 'archive-folder-hero': isFolder }]}>
    {heroCover && <FolderLandscape group={coverGroup} />}
    <div class="archive-heading-copy">
      <p class="archive-kicker">{labels[kind]}</p>
      <h1 data-pagefind-meta="title">{title}</h1>
      {description && <p class="archive-description">{description}</p>}
      {isFolder && (
        <p class="archive-folder-marker" aria-hidden="true">
          <span></span>
          {coverGroup === 'camp' && locale === 'zh' ? '沿途随记 / ' : ''}
          {groupCaption}
        </p>
      )}
    </div>
    {heroCover && (
      <figure class="archive-folder-cover">
        <ArticleCoverImage image={heroCover} hero sizes="(max-width:640px) 85vw, 420px" />
        <figcaption aria-hidden="true">
          {groupCaption}
          <span>{kind.toUpperCase()} / FIELD NOTES</span>
        </figcaption>
      </figure>
    )}
    <div class="archive-statistics" role="list" aria-label={labels.statistics}>
      {statistics.map((statistic) => (
        <div
          class="archive-statistic"
          role="listitem"
          data-stat-kind={statistic.type}
          data-stat-count={statistic.count}
        >
          <ArchiveStatisticArt {scene} variant={statistic.type} />
          <div class="archive-statistic-copy">
            <strong>{String(statistic.count).padStart(2, '0')}</strong>
            <span>{statistic.label}</span>
          </div>
        </div>
      ))}
    </div>
    {isFolder && kind === 'project' && progress !== undefined && (
      <div class="archive-folder-progress">
        <span>{labels.progress}</span>
        <progress value={progress} max="100" aria-label={labels.progress}>
          {progress}%
        </progress>
        <strong>{progress}%</strong>
        {statusLabel && <small>{statusLabel}</small>}
      </div>
    )}
    {kind === 'collection' && cards.length > 0 && (
      <nav class="archive-folder-chapters" aria-label={labels.contents}>
        {cards.slice(0, 3).map((card, index) => (
          <a href={card.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {card.title}
          </a>
        ))}
      </nav>
    )}
  </header>
  <div class:list={['archive-layout', { 'archive-layout-wide': isFolder }]}>
    {!isFolder && (
      <aside class="archive-rail">
        <nav aria-label={labels.contents}>
          <p class="archive-rail-title">{labels.contents}</p>
          {groups.map((group) => (
            <a href={`#archive-${group.type}`}>
              <span>{group.title}</span>
              <span>{group.cards.length}</span>
            </a>
          ))}
        </nav>
      </aside>
    )}
    <div class="archive-sections">
      {groups.length ? (
        groups.map((group) => (
          <section
            class={`archive-group archive-group-${group.type}`}
            aria-labelledby={`archive-${group.type}`}
          >
            <header class="archive-group-heading">
              <h2 id={`archive-${group.type}`}>{group.title}</h2>
              <span>{String(group.cards.length).padStart(2, '0')}</span>
            </header>
            <ol class="archive-entries">
              {group.cards.map((card, index) => (
                <li>
                  <a
                    class:list={[
                      'archive-entry',
                      { 'archive-entry-has-cover': card.kind === 'article' && Boolean(card.cover) },
                      {
                        'archive-folder-entry':
                          card.kind === 'project' || card.kind === 'collection',
                      },
                      {
                        'archive-folder-project': card.kind === 'project',
                        'archive-folder-collection': card.kind === 'collection',
                      },
                    ]}
                    data-cover-group={
                      card.kind === 'project' || card.kind === 'collection'
                        ? (card.coverGroup ?? coverGroup)
                        : undefined
                    }
                    href={card.href}
                    title={card.title}
                  >
                    <span class="archive-number" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="archive-entry-copy">
                      {card.kind === 'article' && card.cover && card.meta && (
                        <span class="archive-entry-date">{card.meta}</span>
                      )}
                      {card.eyebrow && group.type !== 'article' && (
                        <small class="archive-entry-state">{card.eyebrow}</small>
                      )}
                      <h3>{card.title}</h3>
                      {card.description && <p>{card.description}</p>}
                      {card.tags?.length ? (
                        <span class="archive-tags">
                          {card.tags
                            .slice(0, 4)
                            .map((tag) => `#${tag}`)
                            .join(' · ')}
                        </span>
                      ) : null}
                    </div>
                    <span class="archive-entry-end">
                      {card.meta && !card.cover && <span>{card.meta}</span>}
                      <i aria-hidden="true">↗</i>
                    </span>
                    {card.cover && (
                      <span
                        class={
                          card.kind === 'article'
                            ? 'archive-entry-cover'
                            : 'archive-folder-entry-cover'
                        }
                      >
                        <ArticleCoverImage
                          image={card.cover}
                          sizes={
                            card.kind === 'article' ? undefined : '(max-width:640px) 38vw, 360px'
                          }
                        />
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      ) : (
        <p class="archive-empty">{emptyLabel}</p>
      )}
    </div>
  </div>
</main>
