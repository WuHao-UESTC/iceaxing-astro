---

<svg
  class="archive-statistic-art"
  data-stat-scene={scene}
  viewBox="0 0 160 144"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g transform={variant === 'article' ? 'rotate(6 80 72)' : undefined}>
    {landscapes[scene].map(([d, tone]) => (
      <path class={`archive-fragment archive-fragment-${tone}`} d={d} />
    ))}
  </g>
</svg>
