---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
  label: string;
}
const { headings, label } = Astro.props;
const visible = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
---

{visible.length > 0 && (
  <details class="reader-toc" data-reader-toc open>
    <summary>
      <span>{label}</span>
      <small>{String(visible.length).padStart(2, '0')}</small>
      <i aria-hidden="true">⌄</i>
    </summary>
    <nav aria-label={label}>
      <ol>
        {visible.map((heading) => (
          <li data-depth={heading.depth}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}
