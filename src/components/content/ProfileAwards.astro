---
import type { Profile } from '../../content/profile-schema';
import type { Locale } from '../../i18n/config';

interface Props {
  honors: Profile['honors'];
  locale: Locale;
}
const { honors, locale } = Astro.props;
const labels = {
  zh: {
    previous: '上一页证书',
    next: '下一页证书',
    missing: '证书图片待补充',
    view: '查看证书',
    gallery: '获奖证书画廊',
    count: '页',
    close: '关闭大图',
  },
  en: {
    previous: 'Previous certificates',
    next: 'Next certificates',
    missing: 'Certificate image not available',
    view: 'View certificate',
    gallery: 'Award certificates',
    count: 'page',
    close: 'Close enlarged certificate',
  },
  de: {
    previous: 'Vorherige Nachweise',
    next: 'Nächste Nachweise',
    missing: 'Nachweisbild noch nicht verfügbar',
    view: 'Nachweis ansehen',
    gallery: 'Auszeichnungen',
    count: 'Seite',
    close: 'Großansicht schließen',
  },
}[locale];
const pageCount = Math.ceil(honors.length / 3);
---

<profile-award-gallery aria-label={labels.gallery}>
  <div class="profile-gallery-stage">
    <div class="profile-gallery-controls" hidden>
      <button type="button" data-gallery-previous aria-label={labels.previous}>
        <svg
          viewBox="0 0 32 32"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M25 16H7m8-8-8 8 8 8" />
        </svg>
      </button>
      <button type="button" data-gallery-next aria-label={labels.next}>
        <svg
          viewBox="0 0 32 32"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M7 16h18m-8-8 8 8-8 8" />
        </svg>
      </button>
    </div>
    <ul class="profile-certificate-grid" tabindex="0" aria-label={labels.gallery}>
      {honors.map((item) => (
        <li>
          <figure class="profile-certificate">
            <div class="profile-certificate-media">
              <div
                class="profile-certificate-placeholder"
                aria-hidden={Boolean(item.certificateImage)}
              >
                <span aria-hidden="true">◇</span>
                <span>{labels.missing}</span>
              </div>
              {item.certificateImage && (
                <a
                  href={item.certificateImage}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${labels.view}: ${item.title}`}
                  data-certificate-open
                >
                  <img
                    src={item.certificateImage}
                    alt={item.title}
                    width="320"
                    height="220"
                    loading="lazy"
                    decoding="async"
                    data-profile-image
                  />
                </a>
              )}
              {(item.period || item.level) && (
                <div class="profile-certificate-badge">
                  {item.period && <span>{item.period}</span>}
                  {item.level && <span>{item.level}</span>}
                </div>
              )}
            </div>
            <figcaption class="profile-certificate-caption">
              <h3>{item.title}</h3>
            </figcaption>
          </figure>
          {(item.description || item.url) && (
            <div class="profile-certificate-details">
              {item.description && <p class="profile-description">{item.description}</p>}
              {item.url && (
                <a
                  class="profile-text-link"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {labels.view}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
  <span class="profile-gallery-counter" aria-live="polite" aria-atomic="true" hidden>
    <span data-gallery-current>1</span> / <span data-gallery-total>{pageCount}</span>{' '}
    <span class="sr-only">{labels.count}</span>
  </span>
  <dialog class="profile-certificate-lightbox" aria-label={labels.view}>
    <div class="profile-lightbox-shade" aria-hidden="true"></div>
    <button class="profile-lightbox-target" type="button" aria-label={labels.close}>
      <img class="profile-lightbox-image" alt="" />
    </button>
  </dialog>
</profile-award-gallery>

<script>
  import { registerProfileGallery } from '../../scripts/profile-gallery';
  registerProfileGallery();
</script>
