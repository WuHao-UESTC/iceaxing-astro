---
interface Props {
  scene: 'ridge' | 'study' | 'field' | 'camp';
}
const { scene } = Astro.props;
// The motif is confined to x=288..352, with clear gaps to the side rules.
// Faces meet only at shared edges. No strokes cross the central motif.
const designs = {
  ridge: [
    'M290 31L311 10L306 31Z',
    'M311 10L321 31H306Z',
    'M322 31L335 17L331 31Z',
    'M335 17L350 31H331Z',
  ],
  study: [
    'M288 31L301 17L305 31Z',
    'M307 31L321 8L316 31Z',
    'M321 8L332 31H316Z',
    'M335 31L343 20L352 31Z',
  ],
  field: [
    'M289 15L313 18L307 25L289 23Z',
    'M289 23L307 25L300 34Z',
    'M324 23L351 26L346 33L320 30Z',
    'M324 23L320 30L316 36Z',
  ],
  camp: [
    'M296 22L301 17L306 22L301 27Z',
    'M315 16L320 11L325 16L320 21Z',
    'M334 25L339 20L344 25L339 30Z',
  ],
};
---

<svg class="comment-divider" viewBox="0 0 640 44" fill="none" aria-hidden="true" focusable="false">
  <path class="comment-divider-line" d="M0 23H270 M370 23H640" />
  {designs[scene].map((d, index) => (
    <path class={`comment-divider-facet comment-divider-facet-${index % 3}`} d={d} />
  ))}
</svg>
