  {design.lines.map((d) => (
    <path class="comment-divider-line" d={d} />
  ))}
  {design.facets.map((d, index) => (
    <path class={`comment-divider-facet comment-divider-facet-${index % 3}`} d={d} />
  ))}
  {design.sparks.map((d) => (
    <path class="comment-divider-spark" d={d} />
  ))}
</svg>
