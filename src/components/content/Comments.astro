---
import type { Locale } from '../../i18n/config';
import { commentCopy } from '../../lib/comments/copy';
import '../../styles/comments.css';

interface Props {
  locale: Locale;
  thread?: string;
  admin?: boolean;
}
const { locale, thread = '', admin = false } = Astro.props;
const copy = commentCopy[locale];
const composerId = `comment-compose-${encodeURIComponent(admin ? 'admin' : thread)}`;
---

<section
  class="site-comments"
  data-comments
  data-thread={thread}
  data-locale={locale}
  data-admin={String(admin)}
  aria-label={admin ? copy.admin : copy.title}
  data-pagefind-ignore
>
  <header class="comment-heading">
    <div class="comment-heading-copy">
      <p class="comment-eyebrow">
        {admin ? 'FIELD NOTES / DESK' : 'ALONG THE TRAIL / FIELD NOTES'}
      </p>
      <h2>{admin ? copy.admin : copy.title}</h2>
    </div>
    <div class="comment-heading-aside">
      <svg class="comment-ridgeline" viewBox="0 0 160 60" fill="none" aria-hidden="true">
        <path d="M1 53 31 29 47 40 82 7 111 37 128 24 159 53" />
        <path d="m61 27 13 2 8-7 11 10 7-3M18 53h125M77 12l5-5 6 6" />
        <circle cx="131" cy="10" r="3" />
      </svg>
      <button class="comment-refresh" type="button" data-refresh>
        <span class="comment-refresh-icon" aria-hidden="true">
          ↻
        </span>
        {copy.refresh}
      </button>
    </div>
  </header>
  <div class="comment-identity" data-identity hidden>
    <div class="comment-email-field">
      <span>{copy.email}</span>
      <span data-email></span>
      <button class="comment-quiet" type="button" data-logout>
        {copy.change}
      </button>
    </div>
    <label class="comment-name-field">
      {copy.name}
      <input
        form={composerId}
        name="name"
        autocomplete="nickname"
        maxlength="40"
        placeholder={copy.name}
        required
      />
    </label>
    <a href="/keystatic/comments" data-manage hidden>
      {copy.manage}
    </a>
  </div>
  <p class="comment-intro">{admin ? copy.all : copy.intro}</p>
  <p class="comment-status" data-status role="status" aria-live="polite"></p>
  <div class="comment-auth" data-auth>
    <div class="comment-auth-intro">
      <span class="comment-mail-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </span>
      <div>
        <h3>{copy.join}</h3>
        <p>{admin ? copy.adminOnly : copy.login}</p>
      </div>
    </div>
    <form data-login>
      <label>
        {copy.email}
        <input name="email" type="email" autocomplete="email" maxlength="254" required />
      </label>
      <button class="comment-primary" type="submit">
        {copy.send}
        <span aria-hidden="true">↗</span>
      </button>
    </form>
    <form data-verify hidden>
      <label>
        {copy.code}
        <input
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          required
        />
      </label>
      <button class="comment-primary" type="submit">
        {copy.verify}
        <span aria-hidden="true">↗</span>
      </button>
      <button class="comment-quiet" type="button" data-change>
        {copy.change}
      </button>
    </form>
  </div>
  <form id={composerId} class="comment-composer" data-compose hidden>
    <p class="comment-eyebrow comment-compose-caption" aria-hidden="true">
      YOUR FIELD NOTE
    </p>
    <p data-replying hidden></p>
    <button class="comment-quiet" type="button" data-cancel hidden>
      {copy.cancel}
    </button>
    <label>
      {copy.body}
      <textarea
        name="body"
        rows="4"
        maxlength="5000"
        placeholder={copy.placeholder}
        required
      ></textarea>
    </label>
    <button class="comment-primary" type="submit">
      {copy.submit}
      <span aria-hidden="true">↗</span>
    </button>
  </form>
  {admin && (
    <section data-blocklist hidden>
      <h3>{copy.blocked}</h3>
      <div data-blocked></div>
    </section>
  )}
  <div class="comment-list" data-list aria-live="polite"></div>
  <button type="button" data-more hidden>
    {copy.more}
  </button>
</section>
<script>
  import { initComments } from '../../scripts/comments';
  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>
