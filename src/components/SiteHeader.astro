---
import { getMessages } from '../i18n/messages';
import { localizedPath, type Locale } from '../i18n/config';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, alternatePaths } = Astro.props;
const messages = getMessages(locale);
const homeHref = localizedPath(locale);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { label: messages.nav.technology, href: `${homeHref}#technical-ridge` },
  { label: messages.nav.study, href: `${homeHref}#study-terrace` },
  { label: messages.nav.life, href: `${homeHref}#snowfield-traverse` },
  { label: messages.nav.ramblings, href: localizedPath(locale, '/daily-ramblings') },
  { label: messages.nav.tools, href: localizedPath(locale, '/tools') },
  { label: messages.nav.about, href: localizedPath(locale, '/about') },
  { label: messages.nav.profile, href: localizedPath(locale, '/profile') },
  { label: messages.nav.friends, href: localizedPath(locale, '/friends') },
].map((item) => {
  const hrefPath = (item.href.split('#')[0] ?? item.href).replace(/\/+$/, '') || '/';
  return { ...item, current: !item.href.includes('#') && currentPath === hrefPath };
});
---

<header class="site-header" data-pagefind-ignore>
  <div class="shell header-inner">
    <a
      class="brand"
      href={localizedPath(locale)}
      aria-label={`${messages.meta.title} — ${messages.nav.home}`}
    >
      iceaxing<span aria-hidden="true">.</span>
    </a>

    <nav class="desktop-navigation" aria-label={messages.nav.primary}>
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-open" type="button" data-search-open aria-label={messages.nav.search}>
        <span aria-hidden="true">⌕</span>
      </button>
      <details class="language-menu" data-header-details>
        <summary aria-label={messages.common.language}>{locale.toUpperCase()}</summary>
        <div class="language-options">
          <a
            href={alternatePaths?.zh ?? '/'}
            lang="zh-CN"
            aria-current={locale === 'zh' ? 'page' : undefined}
          >
            中文
          </a>
          <a
            href={alternatePaths?.en ?? '/en'}
            lang="en"
            aria-current={locale === 'en' ? 'page' : undefined}
          >
            English
          </a>
          <a
            href={alternatePaths?.de ?? '/de'}
            lang="de"
            aria-current={locale === 'de' ? 'page' : undefined}
          >
            Deutsch
          </a>
        </div>
      </details>
      <ThemeToggle label={messages.common.switchTheme} />
      <details class="site-menu" data-site-menu data-header-details>
        <summary aria-label={messages.nav.menu} title={messages.nav.menu}>
          <span aria-hidden="true" />
        </summary>
        <nav aria-label={messages.nav.primary}>
          <ul class="site-menu-list">
            {navItems.map((item, index) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const headerDetails = [...document.querySelectorAll<HTMLDetailsElement>('[data-header-details]')];
  const siteMenu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');

  headerDetails.forEach((details) => {
    details.addEventListener('toggle', () => {
      if (!details.open) return;
      headerDetails.forEach((other) => {
        if (other !== details) other.open = false;
      });
    });
  });

  siteMenu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    siteMenu.open = false;
    siteMenu.querySelector<HTMLElement>('summary')?.focus();
  });
</script>
