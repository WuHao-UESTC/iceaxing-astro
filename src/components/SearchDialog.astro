---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/config';
import { byOrder, localizedLabel } from '../lib/content';
import { searchCopy } from '../lib/search-copy';
import { searchQueryLimit, searchTypes } from '../lib/search';
import '../styles/search.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = searchCopy[locale];
const categories = byOrder(await getCollection('categories'));
---

<dialog
  class="search-dialog"
  data-search-dialog
  data-locale={locale}
  data-search-mode={import.meta.env.DEV ? 'fallback' : 'pagefind'}
  aria-labelledby="search-dialog-title"
  data-pagefind-ignore
>
  <div class="search-dialog-card">
    <header>
      <div>
        <p>ICEAXING / SEARCH</p>
        <h2 id="search-dialog-title">{copy.title}</h2>
      </div>
      <button type="button" data-search-close aria-label={copy.close}>
        ×
      </button>
    </header>
    <form role="search" data-search-form>
      <div class="search-input-row">
        <label class="sr-only" for="site-search-query">
          {copy.title}
        </label>
        <span class="search-input-symbol" aria-hidden="true">
          ⌕
        </span>
        <input
          id="site-search-query"
          type="search"
          name="query"
          placeholder={copy.placeholder}
          maxlength={searchQueryLimit}
          autocomplete="off"
          spellcheck="false"
          aria-controls="site-search-results"
        />
        <button type="button" class="search-clear" data-search-clear aria-label={copy.clear} hidden>
          ×
        </button>
      </div>
      <div class="search-filters">
        <label>
          <span>{copy.type}</span>
          <select name="type">
            <option value="">{copy.all}</option>
            {searchTypes.map((type) => (
              <option value={type}>{copy[type]}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{copy.category}</span>
          <select name="category">
            <option value="">{copy.all}</option>
            {categories.map((category) => (
              <option value={category.data.categoryId}>
                {localizedLabel(category, locale).title}
              </option>
            ))}
          </select>
        </label>
        <button type="button" class="search-reset" data-search-reset hidden>
          {copy.reset}
        </button>
      </div>
    </form>
    <div class="search-feedback">
      <p
        class="search-status"
        data-search-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {copy.hint}
      </p>
      <button type="button" class="search-action" data-search-retry hidden>
        {copy.retry}
      </button>
    </div>
    <ol class="search-results" id="site-search-results" data-search-results aria-busy="false"></ol>
    <button type="button" class="search-action search-more" data-search-more hidden>
      {copy.more}
    </button>
    <footer class="search-help" aria-label={copy.shortcut}>
      <span>
        <kbd>↑</kbd> <kbd>↓</kbd> {copy.navigate}
      </span>
      <span>
        <kbd>Enter</kbd> {copy.open}
      </span>
      <span>
        <kbd>Esc</kbd> {copy.escape}
      </span>
      <span>
        <kbd>Ctrl / ⌘ K</kbd>
      </span>
    </footer>
  </div>
</dialog>

<script>
  import { initSearchDialog } from '../scripts/search-dialog';
  initSearchDialog();
</script>
