---
import { getContentIndex, isPublicContent, routeFor } from '../../lib/content';
import {
  resolveWikiTarget,
  wikiLinkHref,
  type WikiLinkTarget,
  type WikiLinkValue,
} from '../../lib/wikilinks';

type Props = WikiLinkValue;
const { target, label = '', anchor = '' } = Astro.props;
const index = await getContentIndex();
const targets: WikiLinkTarget[] = [];
for (const [kind, entries] of [
  ['article', index.articles],
  ['log', index.logs],
  ['page', index.pages],
] as const) {
  for (const entry of entries) {
    targets.push({
      id: entry.data.contentId,
      title: entry.data.title,
      locale: entry.data.locale,
      kind,
      href: isPublicContent(entry.data)
        ? routeFor(entry.data.contentId, entry.data.locale, kind)
        : undefined,
    });
  }
}
const locale = Astro.url.pathname.startsWith('/en/')
  ? 'en'
  : Astro.url.pathname.startsWith('/de/')
    ? 'de'
    : 'zh';
const resolved = resolveWikiTarget(target, targets, locale);
const href = resolved && wikiLinkHref(resolved, anchor);
const text = label || resolved?.title || target;
---

{href ? (
  <a class="wikilink" href={href}>
    {text}
  </a>
) : (
  <span
    class="wikilink-unresolved"
    title={resolved ? '目标文章尚未发布' : '目标文章不存在或标题不唯一'}
  >
    {text}
  </span>
)}
