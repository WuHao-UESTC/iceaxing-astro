---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { htmlLanguage, localizedPath, locales, type Locale } from '../i18n/config';
import '../styles/global.css';
import '../styles/page-motion.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  alternatePaths?: Partial<Record<Locale, string>>;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  pagefindType?: string;
  pagefindCategory?: string;
  fullViewport?: boolean;
  standalone?: boolean;
}

const {
  locale,
  title,
  description,
  noindex = false,
  image = '/favicon.svg',
  type = 'website',
  publishedAt,
  alternatePaths,
  jsonLd,
  pagefindType = 'page',
  pagefindCategory,
  fullViewport = false,
  standalone = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={htmlLanguage[locale]} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta data-pagefind-filter="locale[content]" content={locale} />
    <meta data-pagefind-filter="type[content]" content={pagefindType} />
    <meta data-pagefind-meta="type[content]" content={pagefindType} />
    {pagefindCategory && (
      <>
        <meta data-pagefind-filter="category[content]" content={pagefindCategory} />
        <meta data-pagefind-meta="category[content]" content={pagefindCategory} />
      </>
    )}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {locales.map((item) => (
      <link
        rel="alternate"
        hreflang={htmlLanguage[item]}
        href={
          new URL(alternatePaths?.[item] ?? localizedPath(item), Astro.site ?? Astro.url.origin)
        }
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternatePaths?.zh ?? '/', Astro.site ?? Astro.url.origin)}
    />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('iceaxing-theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch {
          // Keep the dark default when storage is unavailable.
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.pageEnterPending = 'true';
          // Failed or blocked enhancement scripts must never leave content hidden.
          window.setTimeout(() => delete document.documentElement.dataset.pageEnterPending, 1500);
        }
      })();
    </script>
  </head>
  <body class:list={{ 'full-viewport-page': fullViewport }}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {!standalone && <SiteHeader locale={locale} {alternatePaths} />}
    <slot />
    {!fullViewport && !standalone && <SiteFooter locale={locale} />}
    {!standalone && <SearchDialog {locale} />}
    <script>
      import '../scripts/page-motion';
    </script>
  </body>
</html>
