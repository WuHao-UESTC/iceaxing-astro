# Canonical production or preview origin, without a trailing slash.
PUBLIC_SITE_URL=http://localhost:4321

# Keystatic defaults to local mode. Set all three values for a deployed GitHub editor.
PUBLIC_KEYSTATIC_STORAGE_KIND=local
PUBLIC_KEYSTATIC_GITHUB_OWNER=
PUBLIC_KEYSTATIC_GITHUB_REPO=

# Comment notifications and administrator login use this verified email.
COMMENTS_OWNER_EMAIL=wushenlunzhe007@163.com

# Exposed in the health endpoint and deployment metadata.
PUBLIC_DEPLOY_ENV=development

# Persistent comments, verification sessions, subscriptions and rate limits.
# Either UPSTASH_* or KV_REST_API_* may be used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email is disabled unless this is explicitly "allowlist" or "production".
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_ALLOWLIST=
RESEND_API_KEY=
RESEND_SEGMENT_ID=
EMAIL_FROM="ICEAXING <notify@example.com>"

# Use at least 32 random bytes. Keep the previous secret during key rotation.
SUBSCRIPTION_TOKEN_SECRET=
SUBSCRIPTION_TOKEN_SECRET_PREVIOUS=

# Protects the post-deployment publication notification endpoint.
PUBLICATION_NOTIFY_SECRET=
NOTIFICATION_BATCH_SIZE=50
EMAIL_SEND_INTERVAL_MS=400
