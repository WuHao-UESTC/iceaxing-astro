---
interface Props {
  number: '01' | '02' | '03' | '04' | '05';
  altitude: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="journey-chapter-marker" aria-hidden="true" data-reveal data-step="1">
  <span>{number}</span>
  <div>
    <strong>EXPEDITION / {number}</strong>
    <small>{label}</small>
  </div>
</div>
