/* V9: a stationary mountain route, horizontal chapters and an editorial selection. */
.snowline-home {
  --journey-height: 100dvh;
  height: var(--journey-height);
  overflow: auto;
}
.snowline-home[data-expedition-ready] {
  display: grid;
  grid-template-columns: 10.5rem minmax(0, 1fr);
  overflow: hidden;
}
.snowline-home .journey-deck {
  position: relative;
  min-width: 0;
  height: 100%;
}
.snowline-home[data-expedition-ready] .snowline-panel {
  position: absolute;
  inset: 0;
  height: 100%;
  min-height: 0;
  overflow: auto;
  overscroll-behavior: contain;
  border: 0;
  scroll-margin: 0;
  scrollbar-width: thin;
}
.snowline-home[data-expedition-ready] .snowline-panel[hidden] {
  display: none;
}
.snowline-home .journey-panel-inner {
  width: calc(100% - 4rem);
  min-height: 100%;
  padding: 1.25rem 0 1.5rem;
  margin: auto;
}
.snowline-home .journey-chapter-marker {
  margin-bottom: 1.25rem;
}
.snowline-home .journey-chapter-heading {
  margin-bottom: 1.5rem;
}
.snowline-home .journey-chapter-heading h2 {
  font-size: clamp(2rem, 3.4vw, 3.5rem);
}
.snowline-home .journey-chapter-heading > p:last-child {
  margin-top: 0.65rem;
  font-size: 0.85rem;
}
.snowline-home .journey-navigation {
  position: relative;
  top: auto;
  z-index: 10;
  width: 100%;
  height: 100%;
  margin: 0;
  border: 0;
  border-right: 1px solid var(--line);
  padding: 1.4rem 0.9rem;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.snowline-home .journey-navigation ol {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  gap: clamp(0.8rem, 3vh, 2rem);
  padding: 1.5rem 0;
}
.snowline-home .journey-navigation li {
  position: relative;
  border: 0;
  background: none;
  color: var(--muted);
  box-shadow: none;
}
.snowline-home .journey-navigation a {
  justify-content: flex-start;
  gap: 0.6rem;
  padding: 0.4rem 0.3rem;
  min-height: 44px;
  font-size: 0.7rem;
}
.snowline-home .journey-navigation a:hover {
  color: var(--text);
}
.snowline-home .journey-navigation li:nth-child(2) {
  margin-left: 0.6rem;
}
.snowline-home .journey-navigation li:nth-child(3) {
  margin-left: 1rem;
}
.snowline-home .journey-navigation li:nth-child(4) {
  margin-left: 0.4rem;
}
.snowline-home .journey-navigation li:nth-child(5) {
  margin-left: 1.2rem;
}
.ridge-node {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 26px;
  height: 26px;
  border: 1px solid var(--line);
  background: var(--page);
  font: 0.55rem var(--font-mono);
  transition: background-color 160ms;
}
.ridge-node-label {
  background: var(--page);
  padding-block: 0.3rem;
  font-size: 0.73rem;
}
.snowline-home .journey-navigation .is-active {
  background: none;
  color: var(--text);
  box-shadow: none;
}
.snowline-home .journey-navigation .is-active a {
  color: var(--text);
}
.snowline-home .journey-navigation .is-active .ridge-node {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--page);
}
.ridge-nav-heading {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  font: 0.7rem var(--font-mono);
}
.ridge-nav-heading small {
  color: var(--muted);
  font-size: 0.45rem;
  letter-spacing: 0.04em;
}
.ridge-nav-line {
  position: absolute;
  inset: 10% 0 6%;
  width: 100%;
  height: 84%;
  opacity: 0.4;
  pointer-events: none;
}
.ridge-nav-line path {
  stroke: var(--line);
  stroke-width: 0.8;
}
.ridge-nav-line .ridge-nav-progress {
  stroke: var(--accent);
  stroke-width: 1.5;
  stroke-dasharray: 1;
  stroke-dashoffset: calc(1 - var(--ridge-progress, 0));
  transition: stroke-dashoffset 350ms;
}
.ridge-nav-foot {
  font: 0.5rem/1.7 var(--font-mono);
  letter-spacing: 0.1em;
  color: var(--muted);
}
.ridge-current-label,
.ridge-expand {
  display: none;
}
.journey-chapter-controls {
  position: absolute;
  right: 2rem;
  top: 0.35rem;
  z-index: 15;
  display: flex;
  align-items: center;
  gap: 1rem;
  height: 2.5rem;
}
.journey-chapter-controls button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  min-width: 44px;
  min-height: 40px;
  border: 0;
  border-bottom: 1px solid var(--line);
  background: var(--page);
  color: var(--text);
  font-size: 0.75rem;
  cursor: pointer;
}
.journey-chapter-controls [data-chapter-prev] {
  font-size: 1.2rem;
  color: var(--muted);
}
.journey-chapter-controls [data-chapter-position] {
  font: 0.55rem var(--font-mono);
  color: var(--muted);
}
.snow-wind {
  position: absolute;
  z-index: 25;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
.snow-wind i {
  position: absolute;
  left: var(--snow-x);
  top: var(--snow-y);
  width: var(--snow-length);
  height: 2px;
  opacity: 0;
  background: var(--expedition-red);
  transform: rotate(-8deg);
}
:root[data-theme='dark'] .snow-wind i {
  height: 1px;
  background: var(--accent);
  box-shadow: 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
}
/* Full-screen cover: compact masthead, generous content viewport, quiet signature. */
.snowline-home .editorial-cover {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  gap: 1rem;
  height: 100%;
  min-height: 34rem;
  padding-block: 1rem;
}
.editorial-masthead {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  align-items: center;
  gap: 2rem;
  border-block: 1px solid var(--text);
  padding: 0.65rem 0;
}
.editorial-brand p {
  margin: 0;
  color: var(--muted);
  font: 0.55rem/1.7 var(--font-mono);
  letter-spacing: 0.08em;
}
.editorial-brand h1 {
  margin: 0.2rem 0;
  font:
    700 clamp(2.6rem, 5.7vw, 5.3rem)/1.05 Georgia,
    serif;
  letter-spacing: -0.065em;
}
.editorial-brand h1 > span {
  color: var(--expedition-red);
}
.editorial-brand .editorial-intro {
  font-family: var(--font-ui);
  font-size: 0.7rem;
  letter-spacing: 0;
}
.editorial-mountain {
  height: clamp(95px, 15vh, 140px);
  overflow: hidden;
}
.editorial-mountain .expedition-art {
  height: 100%;
  border: 0;
  padding: 0;
}
.editorial-mountain .expedition-art-meta,
.editorial-mountain figcaption {
  display: none;
}
.editorial-mountain svg {
  width: 100%;
  height: 100%;
}
.editorial-selection {
  display: flex;
  flex-direction: column;
  min-height: 0;
  scroll-margin: 0;
}
.editorial-selection-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--line);
}
.editorial-selection-header h2 {
  font-size: 0.8rem;
  margin: 0;
  font-weight: 600;
}
.editorial-selection-header > span {
  font: 0.5rem var(--font-mono);
  color: var(--muted);
  letter-spacing: 0.1em;
}
.editorial-scroll {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  overscroll-behavior: contain;
  scroll-behavior: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--line) transparent;
  padding: 0.4rem 1rem 0.5rem 0;
  overflow-anchor: none;
}
.editorial-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.75rem;
  align-items: start;
  padding: 0.75rem 0 2rem;
}
.editorial-item {
  min-width: 0;
}
.editorial-item-0 {
  grid-column: span 2;
}
.editorial-item-1 {
  margin-top: 1.5rem;
}
.editorial-item-3 {
  margin-top: 2rem;
}
.editorial-card {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  min-width: 0;
  padding-top: 0.9rem;
  border-top: 2px solid var(--text);
  text-decoration: none;
}
.editorial-card-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.5rem;
  font: 0.55rem/1.7 var(--font-mono);
  color: var(--muted);
}
.editorial-card-meta > span:first-child {
  color: var(--accent);
}
.editorial-card h3 {
  margin: 0;
  font: 600 clamp(1.1rem, 1.9vw, 1.65rem)/1.5 var(--font-reading);
  overflow-wrap: anywhere;
}
.editorial-item-0 h3 {
  font-size: clamp(1.5rem, 2.6vw, 2.5rem);
}
.editorial-card > p {
  margin: 0;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.85;
}
.editorial-card-image {
  height: clamp(8rem, 17vh, 13rem);
  background: var(--surface-subtle);
}
.editorial-item-0 .editorial-card-image {
  height: clamp(10rem, 23vh, 18rem);
}
.editorial-card-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.editorial-progress {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font: 0.55rem var(--font-mono);
}
.editorial-progress i {
  position: relative;
  flex: 1;
  height: 3px;
  background: var(--line);
}
.editorial-progress i::after {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: var(--progress);
  background: var(--accent);
}
.editorial-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  font-size: 0.6rem;
  color: var(--muted);
}
.editorial-tags span::before {
  content: '#';
}
.editorial-read {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  padding: 0.5rem 0;
  font-size: 0.65rem;
}
.editorial-read > span {
  transition: translate 160ms;
}
.editorial-card:is(:hover, :focus-visible) .editorial-read > span {
  translate: 3px -3px;
}
.editorial-colophon {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 0.6rem 1rem;
  border-top: 1px solid var(--text);
  padding-top: 0.8rem;
}
.editorial-signature p {
  margin: 0;
  font: 600 1.1rem/1.5 var(--font-reading);
}
.editorial-signature small {
  display: block;
  max-width: 45rem;
  margin-top: 0.3rem;
  color: var(--muted);
  font-size: 0.6rem;
}
.editorial-colophon nav {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.65rem;
}
.editorial-colophon a {
  text-decoration: none;
}
.editorial-scroll-hint {
  grid-column: 2;
  font: 0.55rem var(--font-mono);
  color: var(--muted);
  text-align: right;
}
.editorial-empty {
  padding: 2rem 0;
  font-size: 0.9rem;
  color: var(--muted);
}
:root[data-theme='dark'] .editorial-brand h1 {
  font-family: var(--font-mono);
  font-weight: 400;
  font-size: clamp(2.3rem, 4.8vw, 4.5rem);
}
:root[data-theme='dark'] .editorial-mountain .expedition-art {
  border: 0;
  padding: 0;
}
:root[data-theme='dark'] .editorial-card {
  padding: 1rem;
  border: 1px solid var(--line);
  background: var(--surface);
  position: relative;
}
:root[data-theme='dark'] .editorial-card::before {
  content: '';
  position: absolute;
  inset: 4px auto auto 4px;
  width: 9px;
  height: 9px;
  border-top: 1px solid var(--accent);
  border-left: 1px solid var(--accent);
}
.snowline-home .journey-technical-grid {
  gap: 2rem;
}
.snowline-home .journey-category-route a {
  padding: 1rem 0;
}
.snowline-home .journey-project-card {
  padding: 1rem;
}
.snowline-home .study-atlas-stage {
  height: clamp(16rem, 40vh, 27rem);
}
.snowline-home .study-atlas-footer {
  padding-top: 0.6rem;
}
.snowline-home .study-atlas-footer p {
  font-size: 0.65rem;
}
.snowline-home .station-scene {
  gap: 2rem;
}
.snowline-home .station-footer {
  margin-top: 1.5rem;
}
.snowline-home .life-recent {
  margin-top: 1.5rem;
}
.snowline-home .snowline-panel:not(.snowline-hero)::after {
  top: 4rem;
  right: 2rem;
  width: 6rem;
  height: 4rem;
}
@media (max-width: 64rem) {
  .snowline-home[data-expedition-ready] {
    grid-template-columns: 8.5rem minmax(0, 1fr);
  }
  .snowline-home .journey-panel-inner {
    width: calc(100% - 2.5rem);
  }
  .editorial-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .editorial-item-0 {
    grid-column: span 1;
  }
  .editorial-masthead {
    gap: 1rem;
  }
}
@media (max-width: 48rem) {
  .snowline-home[data-expedition-ready] {
    grid-template-columns: 3rem minmax(0, 1fr);
  }
  .snowline-home .journey-navigation {
    padding: 1rem 0.25rem;
    border-right: 1px solid var(--line);
    overflow: visible;
  }
  .ridge-nav-heading,
  .ridge-nav-foot {
    display: none;
  }
  .snowline-home .journey-navigation ol {
    gap: 1.25rem;
    justify-content: center;
    padding: 2.5rem 0;
  }
  .snowline-home .journey-navigation li:nth-child(n) {
    margin-left: 0;
  }
  .snowline-home .journey-navigation a {
    min-height: 44px;
    padding: 0;
    justify-content: center;
  }
  .ridge-node-label {
    display: none;
  }
  .ridge-nav-line {
    width: 100%;
    inset: 12% 0 8%;
    height: 80%;
  }
  .ridge-node {
    width: 25px;
    height: 25px;
    font-size: 0.5rem;
  }
  .ridge-expand {
    display: grid;
    place-items: center;
    position: absolute;
    top: 0.5rem;
    left: 0.2rem;
    width: 40px;
    height: 40px;
    border: 0;
    background: var(--page);
    color: var(--text);
  }
  .ridge-current-label {
    display: block;
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    writing-mode: vertical-rl;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.2em;
  }
  .snowline-home .journey-navigation[data-expanded] {
    background: var(--page);
    box-shadow: 8px 0 30px #0003;
    width: min(16rem, 80vw);
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-node-label {
    display: block;
  }
  .snowline-home .journey-navigation[data-expanded] a {
    justify-content: flex-start;
    padding-left: 1rem;
    gap: 1rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-current-label {
    display: none;
  }
  .journey-chapter-controls {
    right: 1rem;
    gap: 0.6rem;
  }
  .journey-chapter-controls button {
    font-size: 0.65rem;
  }
  .journey-chapter-controls [data-chapter-position] {
    font-size: 0.5rem;
  }
  .snowline-home .journey-panel-inner {
    width: calc(100% - 2rem);
    padding-top: 0.8rem;
  }
  .snowline-home .editorial-cover {
    display: grid;
    height: 100%;
    min-height: 32rem;
    gap: 0.75rem;
  }
  .editorial-masthead {
    grid-template-columns: minmax(0, 1fr) 34%;
    gap: 0.5rem;
    padding: 0.65rem 0;
  }
  .editorial-brand h1 {
    font-size: clamp(1.6rem, 6.5vw, 2.4rem);
  }
  :root[data-theme='dark'] .editorial-brand h1 {
    font-size: clamp(1.3rem, 5.5vw, 2rem);
  }
  .editorial-brand p {
    font-size: 0.42rem;
    letter-spacing: 0;
  }
  .editorial-brand .editorial-intro {
    font-size: 0.65rem;
  }
  .editorial-mountain {
    height: 95px;
  }
  .editorial-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .editorial-item-0 {
    grid-column: auto;
  }
  .editorial-item-1,
  .editorial-item-3 {
    margin-top: 0;
  }
  .editorial-scroll {
    padding-right: 0.5rem;
  }
  .editorial-card h3,
  .editorial-item-0 h3 {
    font-size: 1.25rem;
  }
  .editorial-card-image,
  .editorial-item-0 .editorial-card-image {
    height: 9rem;
  }
  .editorial-card > p {
    font-size: 0.75rem;
  }
  .editorial-colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .editorial-signature {
    width: 100%;
  }
  .editorial-signature p {
    font-size: 0.85rem;
  }
  .editorial-signature small {
    display: none;
  }
  .editorial-colophon nav {
    font-size: 0.6rem;
    gap: 0.65rem;
  }
  .editorial-scroll-hint {
    display: none;
  }
  .snowline-home .journey-chapter-heading h2 {
    font-size: 2.1rem;
  }
  .snowline-home .journey-chapter-marker strong,
  .snowline-home .journey-chapter-marker small {
    font-size: 0.42rem;
  }
  .snowline-home .journey-chapter-marker > span {
    font-size: 1.6rem;
  }
  .snowline-home .study-atlas-stage {
    height: 22rem;
  }
  .snowline-home .life-landing-page {
    grid-template-columns: 1fr;
  }
}
@media (prefers-reduced-motion: reduce) {
  .ridge-nav-progress {
    transition: none;
  }
}
.snowline-home .editorial-mountain svg {
  height: 100%;
  width: 100%;
}
.snowline-home[data-expedition-ready] .journey-navigation .is-active {
  background: none;
  box-shadow: none;
  color: var(--text);
}
.snowline-home[data-expedition-ready] .journey-navigation .is-active a {
  color: var(--text);
}

@media (max-width: 48rem) {
  .snowline-home .journey-navigation .ridge-node-label {
    display: none;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-node-label {
    display: block;
  }
}
.snowline-home .ridge-nav-line {
  inset: calc(50% - 10.5rem) 0 auto;
  height: 21rem;
}
/* The sidebar owns every homepage navigation function; there is no header offset. */
.snowline-home .journey-navigation {
  padding: 1rem 0.9rem;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
}
.snowline-home .journey-navigation .ridge-brand {
  min-height: 32px;
  padding: 0;
  display: block;
  font:
    700 0.9rem/1.4 Georgia,
    serif;
  letter-spacing: -0.03em;
  text-decoration: none;
}
.ridge-brand > span {
  color: var(--expedition-red);
}
.snowline-home .journey-navigation ol {
  flex: 1 0 auto;
  min-height: 16rem;
  gap: clamp(0.3rem, 1.8vh, 1.1rem);
  padding: 0.8rem 0;
  margin: 0.5rem 0;
}
.snowline-home .ridge-nav-line {
  top: 5rem;
  height: min(42vh, 22rem);
}
.ridge-utilities {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  background: var(--page);
  border-top: 1px solid var(--line);
  padding-top: 0.6rem;
}
.ridge-global-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 0.5rem;
}
.snowline-home .journey-navigation .ridge-global-links a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.2rem;
  min-width: 0;
  min-height: 36px;
  padding: 0.3rem 0;
  border-bottom: 1px solid var(--line);
  font-size: 0.65rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.ridge-global-links a > span {
  flex-shrink: 0;
  font-size: 0.6rem;
  color: var(--muted);
}
.ridge-tools {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44px;
  gap: 0.5rem;
  margin: 0.7rem 0 0.35rem;
}
.ridge-search,
.ridge-tools .theme-toggle {
  border: 1px solid var(--line);
  border-radius: 0;
  min-width: 44px;
  min-height: 44px;
  background: var(--page);
  color: var(--text);
  cursor: pointer;
}
.ridge-search {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.7rem;
}
.ridge-languages {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.3rem;
}
.snowline-home .journey-navigation .ridge-languages a {
  display: grid;
  place-items: center;
  min-height: 36px;
  padding: 0.25rem;
  font: 0.6rem var(--font-mono);
  border-bottom: 2px solid transparent;
}
.snowline-home .journey-navigation .ridge-languages a[aria-current] {
  border-bottom-color: var(--accent);
  color: var(--text);
}
@media (max-width: 48rem) {
  .snowline-home .journey-navigation {
    overflow: visible;
    padding: 1rem 0.25rem;
  }
  .ridge-utilities {
    display: none;
  }
  .snowline-home .journey-navigation ol {
    margin: 0;
    min-height: 0;
    gap: 1.25rem;
    padding: 2.5rem 0;
    flex: 1;
  }
  .snowline-home .ridge-nav-line {
    top: calc(50% - 10.5rem);
    height: 21rem;
  }
  .snowline-home .journey-navigation[data-expanded] {
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-nav-heading {
    display: flex;
    padding: 0.2rem 0 0.5rem 2.5rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-utilities {
    display: block;
  }
  .snowline-home .journey-navigation[data-expanded] ol {
    flex: 1 0 auto;
    gap: 0.25rem;
    padding: 0.75rem 0;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-global-links a {
    min-height: 44px;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-tools .theme-toggle {
    width: 44px;
    height: 44px;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-languages a {
    min-height: 44px;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-nav-line {
    display: none;
  }
}
.snowline-home .journey-navigation .ridge-brand > span {
  display: inline;
}

/* Sidebar hierarchy: destinations, route, auxiliary index and language. */
.snowline-home[data-expedition-ready] {
  grid-template-columns: 12rem minmax(0, 1fr);
}
.snowline-home .journey-navigation {
  padding: 1.2rem 1rem;
}
.ridge-primary {
  flex-shrink: 0;
  margin-top: 1rem;
}
.ridge-primary-links {
  display: grid;
}
.snowline-home .journey-navigation .ridge-primary-links a {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  min-height: 44px;
  padding: 0.3rem 0;
  font-size: 0.95rem;
  text-decoration: none;
}
.ridge-primary-links small {
  font: 0.55rem var(--font-mono);
  color: var(--muted);
}
.ridge-primary-links a > span:last-child {
  display: block;
}
.ridge-tools {
  margin: 0.7rem 0 0;
}
.ridge-route {
  position: relative;
  display: flex;
  flex: 1 0 17rem;
  min-height: 17rem;
  margin-block: 1rem;
}
.snowline-home .journey-navigation ol {
  flex: 1;
  min-height: 0;
  width: 100%;
  margin: 0;
  padding: 0;
  justify-content: center;
  gap: clamp(0.5rem, 1.6vh, 1rem);
}
.snowline-home .journey-navigation li:nth-child(n) {
  margin-left: 0;
}
.snowline-home .journey-navigation ol a {
  padding: 0.3rem 0.25rem;
  gap: 0.8rem;
}
.ridge-node-label {
  font-size: 0.8rem;
}
.snowline-home .journey-navigation .ridge-route .ridge-nav-line {
  display: block;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
}
.ridge-utilities {
  padding-top: 0.75rem;
}
.ridge-global-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 1rem;
  padding-bottom: 0.75rem;
}
.snowline-home .journey-navigation .ridge-global-links a {
  border: 0;
  min-height: 36px;
  font-size: 0.75rem;
  padding: 0.2rem 0;
  text-decoration: none;
  flex: 0 1 auto;
}
.ridge-languages {
  border-top: 1px solid var(--line);
  padding-top: 0.65rem;
  gap: 0.35rem;
}
.snowline-home .journey-navigation .ridge-languages a {
  min-height: 44px;
  font: 0.8rem var(--font-ui);
  border: 1px solid transparent;
  text-decoration: none;
}
.snowline-home .journey-navigation .ridge-languages a[aria-current] {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
}
/* Side gutters reserve room for controls so transparent hit areas never cover content. */
.snowline-home .journey-panel-inner {
  width: calc(100% - 7rem);
}
.journey-chapter-controls {
  inset: 0;
  height: auto;
  display: block;
  pointer-events: none;
}
.journey-chapter-controls[hidden] {
  display: none;
}
.journey-chapter-controls button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  min-height: 64px;
  padding: 0;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  pointer-events: auto;
  opacity: 0.45;
  transition:
    opacity 160ms,
    background-color 160ms;
}
.journey-chapter-controls [data-chapter-prev] {
  left: 4px;
  font-size: 1.2rem;
}
.journey-chapter-controls [data-chapter-next] {
  right: 4px;
  font-size: 1.2rem;
}
.journey-chapter-controls button:disabled {
  visibility: hidden;
}
.journey-chapter-controls button:hover,
.journey-chapter-controls button:focus-visible {
  opacity: 1;
  background: var(--page);
  border-color: var(--line);
  color: var(--text);
}
.journey-chapter-controls [data-chapter-prev-label],
.journey-chapter-controls [data-chapter-next-label] {
  position: absolute;
  top: calc(100% + 0.4rem);
  padding: 0.45rem 0.65rem;
  width: max-content;
  max-width: min(16rem, 60vw);
  font: 0.75rem/1.5 var(--font-ui);
  background: var(--page);
  border: 1px solid var(--line);
  color: var(--text);
  opacity: 0;
  pointer-events: none;
}
[data-chapter-prev-label] {
  left: 0;
}
[data-chapter-next-label] {
  right: 0;
}
.journey-chapter-controls button:is(:hover, :focus-visible) > span {
  opacity: 1;
}
@media (max-width: 48rem) {
  .snowline-home[data-expedition-ready] {
    grid-template-columns: 3rem minmax(0, 1fr);
  }
  .snowline-home .journey-navigation {
    padding: 1rem 0.25rem;
  }
  .ridge-primary {
    display: none;
  }
  .ridge-route {
    margin-block: 3rem;
    min-height: 18rem;
    flex: 1;
  }
  .snowline-home .journey-navigation ol {
    gap: 1rem;
    padding: 0;
  }
  .snowline-home .journey-navigation ol a {
    justify-content: center;
    padding: 0;
  }
  .snowline-home .journey-navigation[data-expanded] {
    width: min(19rem, 88vw);
    padding: 1rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-primary {
    display: block;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-route {
    flex: 1 0 16rem;
    margin-block: 0.75rem;
    min-height: 16rem;
  }
  .snowline-home .journey-navigation[data-expanded] ol {
    gap: 0.25rem;
    padding: 0;
  }
  .snowline-home .journey-navigation[data-expanded] ol a {
    justify-content: flex-start;
    padding: 0.3rem 0.25rem;
    gap: 0.8rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-primary-links a {
    padding: 0.3rem 0;
    gap: 0.8rem;
  }
  .snowline-home .journey-panel-inner {
    width: calc(100% - 4rem);
  }
  .journey-chapter-controls button {
    width: 28px;
    min-width: 28px;
    min-height: 48px;
    opacity: 0.8;
  }
  .journey-chapter-controls [data-chapter-prev] {
    left: 0;
  }
  .journey-chapter-controls [data-chapter-next] {
    right: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .journey-chapter-controls button {
    transition: none;
  }
}

/* Revision 2: a full-height route between two compact navigation blocks. */
.snowline-home[data-expedition-ready] {
  grid-template-columns: 17rem minmax(0, 1fr);
}
.snowline-home .journey-navigation {
  --sidebar-ink: var(--expedition-ink);
  --sidebar-mark: var(--expedition-red);
  color: var(--sidebar-ink);
  border-right-color: var(--sidebar-ink);
}
.snowline-home .journey-navigation .ridge-brand {
  color: var(--sidebar-ink);
  font-size: 1.15rem;
}
.ridge-primary {
  margin-top: 0.75rem;
}
.ridge-primary-links {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 0.65rem;
}
.snowline-home .journey-navigation .ridge-primary-links a {
  color: var(--sidebar-ink);
  font-size: 0.9rem;
  gap: 0.5rem;
}
.ridge-primary-links small,
.ridge-nav-heading small {
  color: var(--sidebar-ink);
}
.ridge-tools {
  margin-top: 0.5rem;
}
.ridge-search,
.ridge-tools .theme-toggle {
  color: var(--sidebar-ink);
  border-color: var(--sidebar-ink);
}
.ridge-route {
  flex: 1 0 20rem;
  min-height: 20rem;
  margin-block: 0.8rem;
}
.snowline-home .journey-navigation .ridge-route ol {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: repeat(5, minmax(3.6rem, 1fr));
  gap: 0;
  padding: 0;
  margin: 0;
}
.snowline-home .journey-navigation .ridge-route li {
  min-width: 0;
  display: flex;
  align-items: stretch;
}
.snowline-home .journey-navigation .ridge-route ol a {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);
  align-items: center;
  gap: 0.6rem;
  width: 100%;
  padding: 0;
  color: var(--sidebar-ink);
  text-decoration: none;
}
.ridge-route .ridge-node {
  grid-column: 2;
  grid-row: 1;
  position: relative;
  z-index: 1;
  border-color: var(--sidebar-ink);
  color: var(--sidebar-ink);
}
.ridge-route li:nth-child(odd) .ridge-node {
  transform: translateX(5px);
}
.ridge-route li:nth-child(even) .ridge-node {
  transform: translateX(-5px);
}
.snowline-home .journey-navigation .ridge-route .ridge-node-label {
  display: block;
  grid-row: 1;
  font-size: 0.82rem;
  line-height: 1.5;
  padding: 0.25rem 0;
  position: relative;
  z-index: 1;
  overflow-wrap: anywhere;
  background: var(--page);
}
.ridge-route li:nth-child(odd) .ridge-node-label {
  grid-column: 1;
  text-align: right;
}
.ridge-route li:nth-child(even) .ridge-node-label {
  grid-column: 3;
  text-align: left;
}
.snowline-home .journey-navigation .ridge-route .ridge-nav-line {
  opacity: 1;
}
.ridge-route .ridge-nav-line path {
  stroke: var(--sidebar-ink);
  stroke-width: 1.4;
}
.ridge-route .ridge-nav-line .ridge-nav-progress {
  stroke: var(--sidebar-mark);
  stroke-width: 2;
}
.snowline-home .journey-navigation .ridge-route .is-active .ridge-node {
  background: var(--sidebar-mark);
  border-color: var(--sidebar-mark);
  color: var(--page);
}
.snowline-home[data-expedition-ready] .journey-navigation .ridge-route .is-active a,
.snowline-home .journey-navigation .ridge-route .is-active .ridge-node-label {
  color: var(--sidebar-mark);
}
.ridge-utilities {
  border-top: 0;
  padding-top: 0;
}
.ridge-languages {
  border-top: 1px solid var(--sidebar-ink);
  padding-block: 0.7rem;
  gap: 0.5rem;
}
.snowline-home .journey-navigation .ridge-languages a,
.snowline-home .journey-navigation[data-expanded] .ridge-languages a {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0;
  gap: 0;
  min-height: 44px;
  line-height: 1;
  color: var(--sidebar-ink);
}
.snowline-home .journey-navigation .ridge-languages a[aria-current] {
  color: var(--sidebar-mark);
  border-color: var(--sidebar-mark);
  background: color-mix(in srgb, var(--sidebar-mark) 8%, transparent);
}
.ridge-global-links {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.25rem;
  border-top: 1px solid var(--sidebar-ink);
  padding: 0.4rem 0 0;
}
.snowline-home .journey-navigation .ridge-global-links a,
.snowline-home .journey-navigation[data-expanded] .ridge-global-links a {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 0;
  min-height: 44px;
  font-size: 0.75rem;
  color: var(--sidebar-ink);
  gap: 0;
}
.snowline-home .journey-navigation a:is(:hover, :focus-visible),
.snowline-home .journey-navigation button:is(:hover, :focus-visible) {
  color: var(--sidebar-mark);
}
.snowline-home .journey-navigation :is(a, button):focus-visible {
  outline: 2px solid var(--sidebar-mark);
  outline-offset: 2px;
}
@media (max-width: 48rem) {
  .snowline-home[data-expedition-ready] {
    grid-template-columns: 3rem minmax(0, 1fr);
  }
  .snowline-home .journey-navigation .ridge-route {
    margin-block: 3rem 4rem;
    flex: 1 0 20rem;
  }
  .snowline-home .journey-navigation:not([data-expanded]) .ridge-node-label {
    display: none;
  }
  .snowline-home .journey-navigation:not([data-expanded]) .ridge-route ol a {
    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);
    gap: 0;
  }
  .snowline-home .journey-navigation:not([data-expanded]) .ridge-node {
    transform: none;
  }
  .snowline-home .journey-navigation[data-expanded] {
    width: min(19rem, 92vw);
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-route {
    margin-block: 0.8rem;
    flex: 1 0 20rem;
    min-height: 20rem;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-route ol {
    display: grid;
    gap: 0;
    padding: 0;
  }
  .snowline-home .journey-navigation[data-expanded] .ridge-route ol a {
    display: grid;
    padding: 0;
    gap: 0.6rem;
  }
}

/* Fixed edition: positions belong to the layout, never to the content. */
.editorial-selection-header {
  padding: 0;
  border: 0;
}
.editorial-scroll {
  padding: 0 0.5rem 0 0;
}
.editorial-grid {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.75rem;
  padding: 0 0 0.75rem;
}
.editorial-spread {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 0.75rem;
  height: 36rem;
}
.editorial-spread > .editorial-item {
  display: flex;
  min-height: 0;
  min-width: 0;
  margin: 0;
  grid-column: auto;
  grid-row: auto;
}
/* Each composition fills one rectangle; every gutter has the same width. */
.editorial-spread[data-count='1'] {
  height: 22rem;
}
.editorial-spread[data-count='1'] > :nth-child(1) {
  grid-column: 1 / -1;
}
.editorial-spread[data-count='2'] {
  height: 24rem;
}
.editorial-spread[data-count='2'] > :nth-child(1) {
  grid-column: 1 / 4;
}
.editorial-spread[data-count='2'] > :nth-child(2) {
  grid-column: 4 / 7;
}
.editorial-spread[data-count='3'] {
  grid-template-rows: repeat(2, minmax(0, 1fr));
}
.editorial-spread[data-count='3'] > :nth-child(1) {
  grid-column: 1 / 4;
  grid-row: 1 / 3;
}
.editorial-spread[data-count='3'] > :nth-child(2) {
  grid-column: 4 / 7;
  grid-row: 1;
}
.editorial-spread[data-count='3'] > :nth-child(3) {
  grid-column: 4 / 7;
  grid-row: 2;
}
.editorial-spread[data-count='4'] {
  grid-template-rows: repeat(2, minmax(0, 1fr));
}
.editorial-spread[data-count='4'] > :nth-child(odd) {
  grid-column: 1 / 4;
}
.editorial-spread[data-count='4'] > :nth-child(even) {
  grid-column: 4 / 7;
}
.editorial-spread[data-count='5'] {
  height: 52rem;
  grid-template-rows: repeat(6, minmax(0, 1fr));
}
.editorial-spread[data-count='5'] > :nth-child(1) {
  grid-column: 1 / 4;
  grid-row: 1 / 4;
}
.editorial-spread[data-count='5'] > :nth-child(2) {
  grid-column: 1 / 4;
  grid-row: 4 / 7;
}
.editorial-spread[data-count='5'] > :nth-child(3) {
  grid-column: 4 / 7;
  grid-row: 1 / 3;
}
.editorial-spread[data-count='5'] > :nth-child(4) {
  grid-column: 4 / 7;
  grid-row: 3 / 5;
}
.editorial-spread[data-count='5'] > :nth-child(5) {
  grid-column: 4 / 7;
  grid-row: 5 / 7;
}
.editorial-spread[data-count='6'] {
  height: 54rem;
  grid-template-rows: repeat(3, minmax(0, 1fr));
}
.editorial-spread[data-count='6'] > :nth-child(1) {
  grid-column: 1 / 4;
  grid-row: 1;
}
.editorial-spread[data-count='6'] > :nth-child(2) {
  grid-column: 4 / 7;
  grid-row: 1;
}
.editorial-spread[data-count='6'] > :nth-child(3) {
  grid-column: 1 / 3;
  grid-row: 2;
}
.editorial-spread[data-count='6'] > :nth-child(4) {
  grid-column: 3 / 5;
  grid-row: 2;
}
.editorial-spread[data-count='6'] > :nth-child(5) {
  grid-column: 5 / 7;
  grid-row: 2;
}
.editorial-spread[data-count='6'] > :nth-child(6) {
  grid-column: 1 / 7;
  grid-row: 3;
}
.editorial-card {
  --card-ink: #173853;
  --film: 91 139 173;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  flex: 1;
  min-width: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0;
  border: 0;
  background: #dce3e1;
  color: var(--card-ink);
}
.editorial-ink-1 .editorial-card {
  --film: 184 113 109;
  --card-ink: #54262a;
  background: #eadbd5;
}
.editorial-ink-2 .editorial-card {
  --film: 220 211 191;
  --card-ink: #273e4c;
  background: #e9e4d7;
}
.editorial-card-image,
.editorial-item-0 .editorial-card-image {
  position: absolute;
  inset: -4px;
  width: calc(100% + 8px);
  height: calc(100% + 8px);
  background: transparent;
  z-index: -3;
}
.editorial-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: blur(1.5px) saturate(0.85);
}
.editorial-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    linear-gradient(
      180deg,
      rgb(var(--film) / 0.36),
      rgb(var(--film) / 0.23) 40%,
      rgb(var(--film) / 0.42)
    ),
    linear-gradient(
      180deg,
      rgb(249 243 228 / 0.5),
      rgb(249 243 228 / 0.27) 35%,
      rgb(249 243 228 / 0.85)
    );
}
.editorial-card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.12;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23808080' filter='url(%23n)' opacity='.5' d='M0 0h160v160H0z'/%3E%3C/svg%3E");
}
.editorial-card-copy {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: clamp(1.1rem, 1.8vw, 1.65rem);
  overflow-y: auto;
  scrollbar-width: thin;
}
.editorial-card-meta,
.editorial-card-meta > span:first-child,
.editorial-card-copy > p,
.editorial-tags {
  color: inherit;
}
.editorial-card-meta {
  font-size: 0.65rem;
  line-height: 1.6;
}
.editorial-card h3,
.editorial-item-0 h3 {
  font-size: clamp(1.4rem, 1.9vw, 2rem);
  line-height: 1.4;
  color: inherit;
  margin-top: auto;
}
.editorial-item-0 h3,
.editorial-item-4 h3 {
  font-size: clamp(1.65rem, 2.5vw, 2.5rem);
}
.editorial-card-copy > p {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  flex-shrink: 0;
}
.editorial-tags {
  font-size: 0.7rem;
}
.editorial-read {
  margin-top: 0.3rem;
  color: inherit;
  border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  font-size: 0.75rem;
}
.editorial-progress i {
  background: color-mix(in srgb, currentColor 25%, transparent);
}
.editorial-progress i::after {
  background: currentColor;
}
.editorial-card:is(:hover, :focus-visible) {
  color: var(--card-ink);
}
.editorial-card:focus-visible {
  outline: 2px solid var(--card-ink);
  outline-offset: -5px;
}
:root[data-theme='dark'] .editorial-card {
  --card-ink: #f3d4a1;
  --film: 129 96 48;
  background: #222b29;
  color: var(--card-ink);
  padding: 0;
  border: 0;
}
:root[data-theme='dark'] .editorial-ink-1 .editorial-card {
  --film: 155 103 59;
  background: #342a22;
}
:root[data-theme='dark'] .editorial-ink-2 .editorial-card {
  --film: 87 114 108;
  background: #202b29;
}
:root[data-theme='dark'] .editorial-card::before {
  width: auto;
  height: auto;
  border: 0;
  inset: 0;
  background:
    linear-gradient(180deg, rgb(var(--film) / 0.28), rgb(var(--film) / 0.16)),
    linear-gradient(180deg, rgb(15 24 23 / 0.7), rgb(15 24 23 / 0.48) 35%, rgb(15 24 23 / 0.93));
}
@media (max-width: 48rem) {
  .editorial-spread[data-count] {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: auto;
  }
  .editorial-spread > .editorial-item {
    flex: none;
    height: 22rem;
  }
  .editorial-card h3,
  .editorial-item-0 h3,
  .editorial-item-4 h3 {
    font-size: 1.5rem;
  }
}
